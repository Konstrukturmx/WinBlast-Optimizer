// ui/main.slint
// WinBlast0 Main Window Root Component in Slint 1.19

import { Scale, Theme, Motion } from "theme.slint";
import { AppTitlebar } from "shell/titlebar.slint";
import { AppSidebar, NavItemData } from "shell/sidebar.slint";
import { AppStatusbar } from "shell/statusbar.slint";
import { WbButton } from "components/button.slint";
import { WbSwitch } from "components/switch.slint";
import { WbCard } from "components/card.slint";
import { WbBadge } from "components/badge.slint";
import { WbSearchInput } from "components/search_input.slint";
import { WbProgressBar } from "components/progress_bar.slint";
import { WbTweakRow } from "components/tweak_row.slint";
import { WbSparkline } from "components/sparkline.slint";

export { Scale, Theme, Motion }

export component MainWindow inherits Window {
    title: "WinBlast0 — Windows System Optimizer";
    default-font-size: Scale.font-md;
    background: Theme.bg-canvas;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 420px;
    min-height: 400px;
    no-frame: true;

    in-out property <string> active-view: "dashboard";
    in-out property <bool> is-elevated: true;
    in-out property <string> app-version: "1.6.1";
    in-out property <bool> is-maximized: false;

    // Telemetry & Statusbar properties
    in-out property <float> cpu-usage: 0.0;
    in-out property <float> ram-usage: 0.0;
    in-out property <string> ram-text: "0.0 / 0.0 GB";
    in-out property <bool> reboot-pending: false;
    in-out property <bool> worker-active: false;
    in-out property <string> worker-label: "Ready";

    callback navigate(string);
    callback close-window();
    callback minimize-window();
    callback toggle-maximize();
    callback reboot-system();
    callback search-triggered();

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Custom Frameless Titlebar
        AppTitlebar {
            app-title: "WinBlast0";
            version: "v" + root.app-version;
            is-admin: root.is-elevated;
            maximized: root.is-maximized;

            minimize-clicked => { root.minimize-window(); }
            maximize-clicked => { root.toggle-maximize(); }
            close-clicked => { root.close-window(); }
            search-clicked => { root.search-triggered(); }
        }

        // Central Body: Sidebar + Main Content View Host
        HorizontalLayout {
            padding: 0;
            spacing: 0;

            AppSidebar {
                active-view: root.active-view;
                navigate(target) => {
                    root.active-view = target;
                    root.navigate(target);
                }
            }

            // Central View Host Region
            Rectangle {
                clip: true;
                background: Theme.bg-canvas;

                // View content will be mounted here
                VerticalLayout {
                    padding: Scale.space-lg;
                    spacing: Scale.space-md;

                    Rectangle {
                        background: Theme.bg-surface;
                        border-radius: Scale.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: Scale.space-xl;
                            spacing: Scale.space-md;
                            alignment: center;

                            Text {
                                text: "WinBlast0 Slint 1.19 Engine Active";
                                font-size: Scale.font-xl;
                                font-weight: 700;
                                color: Theme.accent;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Active View: " + root.active-view;
                                font-size: Scale.font-md;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Bottom Statusbar
        AppStatusbar {
            cpu-percent: root.cpu-usage;
            ram-percent: root.ram-usage;
            ram-used-text: root.ram-text;
            reboot-pending: root.reboot-pending;
            worker-active: root.worker-active;
            worker-label: root.worker-label;

            reboot-clicked => { root.reboot-system(); }
        }
    }
}

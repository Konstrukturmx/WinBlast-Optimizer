// ui/main.slint
// WinBlast0 v1.7.0 root window (Slint 1.19). Native window frame (Windows snap layouts, DPI).
// Layout mirrors v1.6.1: top bar / [sidebar | view host] / changelog drawer / progress strip / footer,
// plus overlays: compact sidebar drawer, settings dropdown, diff modal, in-progress HUD.

import "fonts/Inter-UI.ttf";
import "fonts/JetBrainsMono-UI.ttf";
import "fonts/AtkinsonHyperlegibleNext-UI.ttf";
import "fonts/IBMPlexSans-UI.ttf";
import "fonts/NotoSans-UI.ttf";
import "fonts/SourceSans3-UI.ttf";
import "fonts/NotoSansSC-UI.ttf";
import { Scale, Theme, Motion, Tr, Typo, Fx } from "theme.slint";
import { AppStore, ChangelogEntry, DiffRowData, ChoiceItem, PaletteItem, ToastItem } from "stores/app.slint";
import { MatrixStore, MatrixRow, MatrixCategory } from "stores/matrix.slint";
import { DashboardStore, CategoryStat } from "stores/dashboard.slint";
import { CleanAppsStore, CleanTargetRow, AppxRow, FeatureRow, WingetRow } from "stores/clean_apps.slint";
import { StartupStore, StartupRow } from "stores/startup.slint";
import { BackupStore, RestorePointRow, LedgerRow } from "stores/backup.slint";
import { PrivacyStore } from "stores/privacy.slint";
import { GpuStore, GpuAdapterRow, GpuTweakRow } from "stores/gpu.slint";
import { HardwareStore } from "stores/hardware.slint";
import { KvRow, TitledRow, ChipItem, MeterCell } from "stores/common.slint";
import { ParkingStore, ThermalStore, DiskStore, CoreCard, ThermalRow, DriveCard } from "stores/sensors.slint";
import { DriverStore, DriverRow, DisplayDriverRow } from "stores/drivers.slint";
import { LatencyStore, LatencyMetric, PingRow } from "stores/latency.slint";
import { PlannerStore, PlanMetric, PlanStep } from "stores/planner.slint";
import { AutomationStore, MaintenanceRow } from "stores/automation.slint";
import { FaultStore, RepairStore, PerfStore, RepairRow } from "stores/diagnostics.slint";
import { AboutStore } from "stores/about.slint";
import { GamingStore, PrereqStore, NetworkStore, ProfileRow, CheckRow, PrereqRow, DnsRow } from "stores/gaming.slint";
import { AppTopBar } from "shell/topbar.slint";
import { AppSidebar } from "shell/sidebar.slint";
import { AppProgressStrip, AppChangelog, AppFooter } from "shell/statusbar.slint";
import { AppDropdown } from "shell/dropdown.slint";
import { WbDiffModal } from "components/diff_modal.slint";
import { WbInProgressHud } from "components/in_progress_hud.slint";
import { WbViewEnter, WbAurora } from "components/fx.slint";
import { AppCommandPalette } from "shell/command_palette.slint";
import { AppToasts } from "shell/toast.slint";
import { EasyDashboardView } from "views/easy_dashboard.slint";
import { AdvancedMatrixView } from "views/advanced_matrix.slint";
import { CleanAppsView } from "views/clean_apps.slint";
import { StartupTasksView } from "views/startup_tasks.slint";
import { GpuTuningView } from "views/gpu_tuning.slint";
import { CpuParkingView } from "views/cpu_parking.slint";
import { HardwareViewComponent } from "views/hardware_view.slint";
import { ThermalMonitorView } from "views/thermal_monitor.slint";
import { DiskHealthView } from "views/disk_health.slint";
import { DriverBiosView } from "views/driver_bios.slint";
import { LatencyBenchView } from "views/latency_bench.slint";
import { GamingStatsView } from "views/gaming_stats.slint";
import { NetworkDiagView } from "views/network_diag.slint";
import { PerformanceTestsView } from "views/performance_tests.slint";
import { GameProfilesView } from "views/game_profiles.slint";
import { GameOverlayView } from "views/game_overlay.slint";
import { GameSuitabilityView } from "views/game_suitability.slint";
import { GamePrereqsView } from "views/game_prereqs.slint";
import { AutomationCenterView } from "views/automation_center.slint";
import { GoalPlannerView } from "views/goal_planner.slint";
import { WindowsRepairView } from "views/windows_repair.slint";
import { FaultDiagnosticsView } from "views/fault_diagnostics.slint";
import { BackupCenterView } from "views/backup_center.slint";
import { PrivacyShieldView } from "views/privacy_shield.slint";
import { SupportAboutView } from "views/support_about.slint";
import { SettingsView } from "views/settings.slint";
import { WindowsSetupView } from "views/windows_setup.slint";
import { Nav, NavTab } from "stores/nav.slint";
import { WbPageTabs } from "components/page_tabs.slint";

export { Scale, Theme, Motion, Tr, Typo, Fx, AppStore, ChangelogEntry, DiffRowData, ChoiceItem, PaletteItem, ToastItem, MatrixStore, MatrixRow, MatrixCategory, DashboardStore, CategoryStat, CleanAppsStore, CleanTargetRow, AppxRow, FeatureRow, WingetRow, StartupStore, StartupRow, BackupStore, RestorePointRow, LedgerRow, PrivacyStore, GpuStore, GpuAdapterRow, GpuTweakRow, HardwareStore, KvRow, TitledRow, ChipItem, MeterCell, ParkingStore, ThermalStore, DiskStore, CoreCard, ThermalRow, DriveCard, DriverStore, DriverRow, DisplayDriverRow, LatencyStore, LatencyMetric, PingRow, PlannerStore, PlanMetric, PlanStep, AutomationStore, MaintenanceRow, FaultStore, RepairStore, PerfStore, RepairRow, GamingStore, PrereqStore, NetworkStore, ProfileRow, CheckRow, PrereqRow, DnsRow, AboutStore }

export component MainWindow inherits Window {
    // Tabs of the merged page that owns the current view (checklist E).
    property <[NavTab]> page-tabs: Nav.tabs-of(Nav.page-of(AppStore.active-view));
    title: "WinBlast0 v" + AppStore.app-version + " — Windows System Optimizer";
    icon: @image-url("../winblast.png");
    default-font-size: Scale.font-md;
    default-font-family: Typo.ui;
    background: Theme.bg-primary;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 420px;
    min-height: 400px;

    // Responsive tier on the zoom-adjusted logical width: 0 compact (<680), 1 medium (<1020), 2 wide.
    // Updated from change handlers (not a binding) so tier-dependent layout constraints cannot
    // form a width -> layout -> width binding loop.
    in-out property <int> tier: 2;
    // Wide enough for the top bar's live CPU/RAM badge and OS text next to all controls.
    in-out property <bool> wide-header: true;
    pure function compute-tier() -> int {
        return root.width / Scale.factor < 680px ? 0 : root.width / Scale.factor < 1020px ? 1 : 2;
    }
    // Logical window width for the top bar's progressive disclosure (see AppTopBar.avail).
    in-out property <float> header-w: 1280;
    init => { root.tier = root.compute-tier(); root.wide-header = root.width / Scale.factor >= 1600px; root.header-w = root.width / Scale.factor / 1px; }
    changed width => { root.tier = root.compute-tier(); root.wide-header = root.width / Scale.factor >= 1600px; root.header-w = root.width / Scale.factor / 1px; }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "k" || event.text == "K") {
                AppStore.dropdown = "";
                AppStore.palette-open = !AppStore.palette-open;
                return accept;
            }
            if event.text == Key.Escape {
                if AppStore.palette-open { AppStore.palette-open = false; return accept; }
                if AppStore.dropdown != "" { AppStore.dropdown = ""; return accept; }
                if AppStore.diff-visible { AppStore.close-diff(); return accept; }
                if AppStore.sidebar-open && root.tier != 2 { AppStore.toggle-sidebar(); return accept; }
                if AppStore.hud-visible { AppStore.dismiss-hud(); return accept; }
                return reject;
            }
            if event.modifiers.control && (event.text == "+" || event.text == "=") { AppStore.set-zoom(AppStore.zoom + 0.1); return accept; }
            if event.modifiers.control && event.text == "-" { AppStore.set-zoom(AppStore.zoom - 0.1); return accept; }
            if event.modifiers.control && event.text == "0" { AppStore.set-zoom(1.0); return accept; }
            if event.modifiers.control && event.text == Key.Tab {
                if event.modifiers.shift { AppStore.nav-prev(); } else { AppStore.nav-next(); }
                return accept;
            }
            if event.text == Key.F5 && !AppStore.is-scanning { AppStore.start-scan(); return accept; }
            reject
        }

        VerticalLayout {
            spacing: 0;
            topbar := AppTopBar { tier: root.tier; roomy: root.wide-header; avail: root.header-w; }
            HorizontalLayout {
                spacing: 0;
                vertical-stretch: 1;
                if root.tier == 2 : AppSidebar { tier: root.tier; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0;
                    if root.page-tabs.length > 1 : WbPageTabs { tabs: root.page-tabs; tier: root.tier; }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    background: Theme.bg-primary;
                WbAurora { seed: Fx.view-serial; }
                if AppStore.active-view == "dashboard" : WbViewEnter { EasyDashboardView { tier: root.tier; } }
                if AppStore.active-view == "matrix" : WbViewEnter { AdvancedMatrixView { tier: root.tier; } }
                if AppStore.active-view == "clean_apps" : WbViewEnter { CleanAppsView { tier: root.tier; } }
                if AppStore.active-view == "startup_tasks" : WbViewEnter { StartupTasksView { tier: root.tier; } }
                if AppStore.active-view == "gpu" : WbViewEnter { GpuTuningView { tier: root.tier; } }
                if AppStore.active-view == "cpu_parking" : WbViewEnter { CpuParkingView { tier: root.tier; } }
                if AppStore.active-view == "hardware" : WbViewEnter { HardwareViewComponent { tier: root.tier; } }
                if AppStore.active-view == "thermal" : WbViewEnter { ThermalMonitorView { tier: root.tier; } }
                if AppStore.active-view == "disk_health" : WbViewEnter { DiskHealthView { tier: root.tier; } }
                if AppStore.active-view == "driver_bios" : WbViewEnter { DriverBiosView { tier: root.tier; } }
                if AppStore.active-view == "latency" : WbViewEnter { LatencyBenchView { tier: root.tier; } }
                if AppStore.active-view == "gaming_stats" : WbViewEnter { GamingStatsView { tier: root.tier; } }
                if AppStore.active-view == "network_diag" : WbViewEnter { NetworkDiagView { tier: root.tier; } }
                if AppStore.active-view == "performance_tests" : WbViewEnter { PerformanceTestsView { tier: root.tier; } }
                if AppStore.active-view == "game_profiles" : WbViewEnter { GameProfilesView { tier: root.tier; } }
                if AppStore.active-view == "game_overlay" : WbViewEnter { GameOverlayView { tier: root.tier; } }
                if AppStore.active-view == "game_suitability" : WbViewEnter { GameSuitabilityView { tier: root.tier; } }
                if AppStore.active-view == "game_prereqs" : WbViewEnter { GamePrereqsView { tier: root.tier; } }
                if AppStore.active-view == "automation" : WbViewEnter { AutomationCenterView { tier: root.tier; } }
                if AppStore.active-view == "goal_planner" : WbViewEnter { GoalPlannerView { tier: root.tier; } }
                if AppStore.active-view == "windows_repair" : WbViewEnter { WindowsRepairView { tier: root.tier; } }
                if AppStore.active-view == "fault_diagnostics" : WbViewEnter { FaultDiagnosticsView { tier: root.tier; } }
                if AppStore.active-view == "backup" : WbViewEnter { BackupCenterView { tier: root.tier; } }
                if AppStore.active-view == "privacy" : WbViewEnter { PrivacyShieldView { tier: root.tier; } }
                if AppStore.active-view == "support_about" : WbViewEnter { SupportAboutView { tier: root.tier; } }
                if AppStore.active-view == "settings" : WbViewEnter { SettingsView { tier: root.tier; } }
                if AppStore.active-view == "windows_setup" : WbViewEnter { WindowsSetupView { tier: root.tier; } }
                }
                }
            }
            if AppStore.show-changelog : AppChangelog { tier: root.tier; }
            AppProgressStrip {}
            AppFooter { tier: root.tier; }
        }

        // ---- Overlays ----
        if root.tier != 2 && AppStore.sidebar-open : Rectangle {
            background: Theme.scrim;
            TouchArea { clicked => { AppStore.toggle-sidebar(); } }
            AppSidebar {
                x: 0;
                y: topbar.height;
                height: parent.height - topbar.height;
                tier: root.tier;
            }
        }
        if AppStore.dropdown != "" : AppDropdown {
            anchor-x: root.width - Scale.px(300px);
            anchor-y: topbar.height + Scale.px(4px);
        }
        if AppStore.diff-visible : WbDiffModal {}
        if AppStore.hud-visible : WbInProgressHud {}
        toasts := AppToasts {
            width: min(Scale.px(380px), root.width - Scale.px(32px));
            x: root.width - self.width - Scale.px(16px);
            y: root.height - self.preferred-height - Scale.px(56px);
            height: self.preferred-height;
        }
        if AppStore.palette-open : AppCommandPalette {
            closed => { keys.focus(); }
        }
    }

    // Ends the staggered card entrance window opened by Rust on navigation.
    Timer {
        interval: 700ms;
        running: Fx.entering;
        triggered => { Fx.entering = false; }
    }
}

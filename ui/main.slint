// ui/main.slint
// WinBlast0 v1.7.0 root window (Slint 1.19). Native window frame (Windows snap layouts, DPI).
// Layout mirrors v1.6.1: top bar / [sidebar | view host] / changelog drawer / progress strip / footer,
// plus overlays: compact sidebar drawer, settings dropdown, diff modal, in-progress HUD.

import { Scale, Theme, Motion, Tr } from "theme.slint";
import { AppStore, ChangelogEntry, DiffRowData, ChoiceItem } from "stores/app.slint";
import { AppTopBar } from "shell/topbar.slint";
import { AppSidebar } from "shell/sidebar.slint";
import { AppProgressStrip, AppChangelog, AppFooter } from "shell/statusbar.slint";
import { AppDropdown } from "shell/dropdown.slint";
import { WbDiffModal } from "components/diff_modal.slint";
import { WbInProgressHud } from "components/in_progress_hud.slint";
import { EasyDashboardView } from "views/easy_dashboard.slint";
import { AdvancedMatrixView } from "views/advanced_matrix.slint";
import { CleanAppsView } from "views/clean_apps.slint";
import { StartupTasksView } from "views/startup_tasks.slint";
import { GpuTuningView } from "views/gpu_tuning.slint";
import { CpuParkingView } from "views/cpu_parking.slint";
import { HardwareViewComponent } from "views/hardware_view.slint";
import { ThermalMonitorView } from "views/thermal_monitor.slint";
import { DiskHealthView } from "views/disk_health.slint";
import { DriverBiosView } from "views/driver_bios.slint";
import { LatencyBenchView } from "views/latency_bench.slint";
import { FpsBenchmarkView } from "views/fps_benchmark.slint";
import { GamingStatsView } from "views/gaming_stats.slint";
import { NetworkDiagView } from "views/network_diag.slint";
import { PerformanceTestsView } from "views/performance_tests.slint";
import { GameProfilesView } from "views/game_profiles.slint";
import { GameOverlayView } from "views/game_overlay.slint";
import { GameSuitabilityView } from "views/game_suitability.slint";
import { GamePrereqsView } from "views/game_prereqs.slint";
import { AutomationCenterView } from "views/automation_center.slint";
import { GoalPlannerView } from "views/goal_planner.slint";
import { WindowsRepairView } from "views/windows_repair.slint";
import { FaultDiagnosticsView } from "views/fault_diagnostics.slint";
import { BackupCenterView } from "views/backup_center.slint";
import { PrivacyShieldView } from "views/privacy_shield.slint";
import { SupportAboutView } from "views/support_about.slint";

export { Scale, Theme, Motion, Tr, AppStore, ChangelogEntry, DiffRowData, ChoiceItem }

export component MainWindow inherits Window {
    title: "WinBlast0 v" + AppStore.app-version + " — Windows System Optimizer";
    icon: @image-url("../winblast.png");
    default-font-size: Scale.font-md;
    background: Theme.bg-primary;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 420px;
    min-height: 400px;

    // Responsive tier on the zoom-adjusted logical width: 0 compact (<680), 1 medium (<1020), 2 wide.
    // Updated from change handlers (not a binding) so tier-dependent layout constraints cannot
    // form a width -> layout -> width binding loop.
    in-out property <int> tier: 2;
    pure function compute-tier() -> int {
        return root.width / Scale.factor < 680px ? 0 : root.width / Scale.factor < 1020px ? 1 : 2;
    }
    init => { root.tier = root.compute-tier(); }
    changed width => { root.tier = root.compute-tier(); }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if AppStore.dropdown != "" { AppStore.dropdown = ""; return accept; }
                if AppStore.diff-visible { AppStore.close-diff(); return accept; }
                if AppStore.sidebar-open && root.tier != 2 { AppStore.toggle-sidebar(); return accept; }
                if AppStore.hud-visible { AppStore.dismiss-hud(); return accept; }
                return reject;
            }
            if event.modifiers.control && (event.text == "+" || event.text == "=") { AppStore.set-zoom(AppStore.zoom + 0.1); return accept; }
            if event.modifiers.control && event.text == "-" { AppStore.set-zoom(AppStore.zoom - 0.1); return accept; }
            if event.modifiers.control && event.text == "0" { AppStore.set-zoom(1.0); return accept; }
            if event.modifiers.control && event.text == Key.Tab {
                if event.modifiers.shift { AppStore.nav-prev(); } else { AppStore.nav-next(); }
                return accept;
            }
            if event.text == Key.F5 && !AppStore.is-scanning { AppStore.start-scan(); return accept; }
            reject
        }

        VerticalLayout {
            spacing: 0;
            topbar := AppTopBar { tier: root.tier; }
            HorizontalLayout {
                spacing: 0;
                vertical-stretch: 1;
                if root.tier == 2 : AppSidebar { tier: root.tier; }
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    background: Theme.bg-primary;
                if AppStore.active-view == "dashboard" : EasyDashboardView { tier: root.tier; }
                if AppStore.active-view == "matrix" : AdvancedMatrixView { tier: root.tier; }
                if AppStore.active-view == "clean_apps" : CleanAppsView { tier: root.tier; }
                if AppStore.active-view == "startup_tasks" : StartupTasksView { tier: root.tier; }
                if AppStore.active-view == "gpu" : GpuTuningView { tier: root.tier; }
                if AppStore.active-view == "cpu_parking" : CpuParkingView { tier: root.tier; }
                if AppStore.active-view == "hardware" : HardwareViewComponent { tier: root.tier; }
                if AppStore.active-view == "thermal" : ThermalMonitorView { tier: root.tier; }
                if AppStore.active-view == "disk_health" : DiskHealthView { tier: root.tier; }
                if AppStore.active-view == "driver_bios" : DriverBiosView { tier: root.tier; }
                if AppStore.active-view == "latency" : LatencyBenchView { tier: root.tier; }
                if AppStore.active-view == "fps_benchmark" : FpsBenchmarkView { tier: root.tier; }
                if AppStore.active-view == "gaming_stats" : GamingStatsView { tier: root.tier; }
                if AppStore.active-view == "network_diag" : NetworkDiagView { tier: root.tier; }
                if AppStore.active-view == "performance_tests" : PerformanceTestsView { tier: root.tier; }
                if AppStore.active-view == "game_profiles" : GameProfilesView { tier: root.tier; }
                if AppStore.active-view == "game_overlay" : GameOverlayView { tier: root.tier; }
                if AppStore.active-view == "game_suitability" : GameSuitabilityView { tier: root.tier; }
                if AppStore.active-view == "game_prereqs" : GamePrereqsView { tier: root.tier; }
                if AppStore.active-view == "automation" : AutomationCenterView { tier: root.tier; }
                if AppStore.active-view == "goal_planner" : GoalPlannerView { tier: root.tier; }
                if AppStore.active-view == "windows_repair" : WindowsRepairView { tier: root.tier; }
                if AppStore.active-view == "fault_diagnostics" : FaultDiagnosticsView { tier: root.tier; }
                if AppStore.active-view == "backup" : BackupCenterView { tier: root.tier; }
                if AppStore.active-view == "privacy" : PrivacyShieldView { tier: root.tier; }
                if AppStore.active-view == "support_about" : SupportAboutView { tier: root.tier; }
                }
            }
            if AppStore.show-changelog : AppChangelog { tier: root.tier; }
            AppProgressStrip {}
            AppFooter { tier: root.tier; }
        }

        // ---- Overlays ----
        if root.tier != 2 && AppStore.sidebar-open : Rectangle {
            background: Theme.scrim;
            TouchArea { clicked => { AppStore.toggle-sidebar(); } }
            AppSidebar {
                x: 0;
                y: topbar.height;
                height: parent.height - topbar.height;
                tier: root.tier;
            }
        }
        if AppStore.dropdown != "" : AppDropdown {
            anchor-x: root.width - Scale.px(300px);
            anchor-y: topbar.height + Scale.px(4px);
        }
        if AppStore.diff-visible : WbDiffModal {}
        if AppStore.hud-visible : WbInProgressHud {}
    }
}

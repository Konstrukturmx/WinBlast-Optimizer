// ui/tokens/fx.slint
// Typography families (embedded fonts) and shared motion state for the 1.7.0 visual layer.

export global Typo {
    // Family names as stored in the embedded font files (ui/fonts/).
    // Set from Rust (Settings → Text → Font); one of core::text_render::UI_FONTS.
    in-out property <string> ui: "Inter Variable";
    out property <string> mono: "JetBrains Mono";
    // Simplified Chinese (embedded subset): Windows falls back to a Japanese font for Han text,
    // which has no Simplified-only characters (简, 设, 优 …).
    out property <string> cjk: "Noto Sans SC";
}

export global Fx {
    // Written by Rust on every navigation (src/ui_slint/shell.rs). Panels created while
    // `entering` is true play the staggered entrance; `view-serial` re-seeds the aurora backdrop.
    in-out property <bool> entering: false;
    in-out property <int> stagger: 0;
    in-out property <int> view-serial: 0;
    // True when a hardware GPU drives Slint's default femtovg-wgpu renderer (set by Rust at
    // startup from a DXGI probe). Enables the 3D depth layer: pointer-tracked light, parallax
    // shadows and lift. Components combine it with !Theme.reduced-motion.
    in-out property <bool> gpu: false;
}

// ui/tokens/theme.slint
// Runtime theme tokens. The Rust bridge writes the base palette from core::theme::ThemePalette
// (6 color schemes x 5 styles x dark/light, linear->sRGB converted) whenever the user changes theme.

export enum ThemeMode { dark, light, system }

export global Theme {
    in-out property <bool> dark: true;
    in-out property <bool> supports-blur: true;

    // ---- Base palette (written by Rust at startup and on every theme change) ----
    in-out property <color> bg-primary:          #1d1f2a;
    in-out property <color> bg-sidebar:          #242838;
    in-out property <color> bg-card:             #2e3446;
    in-out property <color> bg-card-hover:       #3b4457;
    in-out property <color> border:              #ffffff14;
    in-out property <color> border-hover:        #ffffff33;
    in-out property <color> border-accent:       #8fbfff80;
    in-out property <color> accent:              #7cacfa;
    in-out property <color> accent-hover:        #8fbfff;
    in-out property <color> accent-press:        #6797e8;
    in-out property <color> btn-secondary:       #3e4757;
    in-out property <color> btn-secondary-hover: #4e5869;
    in-out property <color> btn-secondary-press: #343c4b;
    in-out property <color> sparkline-cpu:       #7cdbf9;
    in-out property <color> sparkline-ram:       #eeb4f9;
    in-out property <color> sparkline-bg:        #ffffff0a;
    in-out property <color> text-primary:        #f9fafc;
    in-out property <color> text-secondary:      #dadde2;
    in-out property <color> text-muted:          #b6bac1;
    in-out property <color> success:             #6ee4ad;
    in-out property <color> warning:             #f9d36c;
    in-out property <color> danger:              #f5888f;
    in-out property <color> neutral-badge:       #898e98;

    // ---- Geometry / motion from UiThemeStyle (written by Rust) ----
    in-out property <length> card-radius: 12px;
    in-out property <length> btn-radius: 8px;
    in-out property <length> input-radius: 8px;
    in-out property <length> badge-radius: 6px;
    in-out property <length> card-padding: 16px;
    in-out property <length> border-width: 1px;
    in-out property <length> sidebar-width: 235px;
    in-out property <duration> motion: 240ms;
    in-out property <bool> reduced-motion: false;

    // ---- Derived semantic tokens ----
    out property <color> bg-canvas:         bg-primary;
    out property <color> bg-surface:        bg-card;
    out property <color> bg-surface-hover:  bg-card-hover;
    out property <color> bg-surface-active: btn-secondary-press;
    out property <color> bg-elevated:       bg-card;
    out property <color> bg-hover:          bg-card-hover;
    out property <color> bg-input:          bg-sidebar;
    out property <color> bg-glass:          bg-card.with-alpha(supports-blur ? 0.86 : 0.98);
    out property <color> bg-glass-strong:   bg-card.with-alpha(supports-blur ? 0.94 : 1.0);
    out property <length> blur-radius:      supports-blur ? 16px : 0px;
    out property <color> scrim:             #000000a0;

    out property <color> text-on-accent:    #ffffff;
    out property <color> text-on-danger:    #ffffff;

    out property <color> border-subtle:     border;
    out property <color> border-default:    border-hover;
    out property <color> border-strong:     border-hover;
    out property <color> border-focus:      border-accent;

    out property <color> accent-pressed:    accent-press;
    out property <color> accent-subtle:     accent.with-alpha(0.16);

    out property <color> danger-hover:      danger.brighter(0.12);
    out property <color> danger-pressed:    danger.darker(0.15);

    out property <color> safe:              success;
    out property <color> safe-bg:           success.with-alpha(0.14);
    out property <color> safe-border:       success.with-alpha(0.35);
    out property <color> low:               success.mix(accent, 0.5);
    out property <color> low-bg:            low.with-alpha(0.14);
    out property <color> low-border:        low.with-alpha(0.35);
    out property <color> moderate:          warning;
    out property <color> moderate-bg:       warning.with-alpha(0.14);
    out property <color> moderate-border:   warning.with-alpha(0.35);
    out property <color> high:              danger;
    out property <color> high-bg:           danger.with-alpha(0.14);
    out property <color> high-border:       danger.with-alpha(0.35);
    out property <color> info:              accent;
    out property <color> info-bg:           accent.with-alpha(0.14);
    out property <color> info-border:       accent.with-alpha(0.35);
    out property <color> neutral:           text-muted;
    out property <color> neutral-bg:        neutral-badge.with-alpha(0.18);
    out property <color> neutral-border:    neutral-badge.with-alpha(0.35);

    out property <color> shadow-sm: #00000040;
    out property <color> shadow-md: #00000066;
    out property <color> shadow-lg: #00000099;
    out property <color> caption-close-hover:   #e81123;
    out property <color> caption-close-pressed: #c50f1f;

    // Animation duration honouring reduced motion.
    out property <duration> anim: reduced-motion ? 0ms : motion;
}

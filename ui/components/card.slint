// ui/components/card.slint
import { Scale, Theme } from "../theme.slint";

export component WbCard inherits Rectangle {
    // Elevation tier: 0 = flat glass, 1 = standard card, 2 = floating panel
    in property <int> elevation: 1;
    in property <length> content-padding: Scale.space-lg;
    in property <bool> interactive: false;

    border-radius: Scale.radius-md;
    background: Theme.bg-glass;
    backdrop-blur: Theme.blur-radius;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: false;

    drop-shadow-blur:
        root.elevation <= 0 ? 0px :
        root.elevation == 1 ? Scale.px(14px) :
                              Scale.px(26px);
    drop-shadow-offset-y:
        root.elevation <= 0 ? 0px :
        root.elevation == 1 ? Scale.px(4px) :
                              Scale.px(10px);
    drop-shadow-color:
        root.elevation <= 0 ? transparent :
        root.elevation == 1 ? Theme.shadow-md :
                              Theme.shadow-lg;

    animate border-color, background {
        duration: 180ms;
        easing: spring(0.1);
    }

    // Subtle top specular hairline for frosted-glass depth
    Rectangle {
        x: Scale.radius-md;
        y: 1px;
        width: max(0px, parent.width - Scale.radius-md * 2);
        height: 1px;
        background: @linear-gradient(90deg, transparent 0%, #ffffff1c 50%, transparent 100%);
    }

    VerticalLayout {
        padding: root.content-padding;
        @children
    }
}

// ui/components/toggle.slint
// Stateless spring toggle: the visual state always comes from the model (`on`), clicks only
// emit `clicked`, so the UI can never drift from the real system state.
import { Scale, Theme, Tr, Fx } from "../theme.slint";
import { WbTip } from "fx.slint";

export component WbToggle inherits Rectangle {
    in property <bool> on;
    in property <bool> busy;
    in property <bool> enabled: true;
    in property <string> accessible-name: "Toggle";
    callback clicked();

    width: Scale.px(40px);
    height: Scale.px(22px);
    border-radius: self.height / 2;
    background: busy ? Theme.warning.with-alpha(0.45) : on ? Theme.accent : Theme.btn-secondary;
    border-width: 1px;
    border-color: on ? Theme.accent-hover : Theme.border-hover;
    opacity: enabled ? 1 : 0.5;
    animate background { duration: Theme.anim; }
    accessible-role: switch;
    accessible-label: root.accessible-name;
    accessible-checked: root.on;
    accessible-enabled: root.enabled && !root.busy;
    accessible-action-default => { if root.enabled && !root.busy { root.clicked(); } }

    TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    knob := Rectangle {
        width: parent.height - 6px;
        height: parent.height - 6px;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        border-radius: self.height / 2;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000055;
        animate x { duration: Theme.anim; easing: ease-out; }
    }
}

// Risk badge with colour-blind friendly symbols (v1.6.1 risk_badge::view_localized).
export component WbRiskBadge inherits Rectangle {
    in property <int> level; // 0 safe, 1 low, 2 moderate, 3 high, 4 extreme
    in property <string> label;
    private property <color> tone: level == 0 ? Theme.success : level == 1 ? Theme.accent : level == 4 ? Theme.danger : Theme.warning;
    private property <float> fill: level == 0 ? 0.18 : level == 1 ? 0.18 : level == 2 ? 0.20 : level == 3 ? 0.28 : 0.32;
    height: Scale.px(22px);
    border-radius: Scale.px(Theme.badge-radius);
    background: tone.with-alpha(fill);
    border-width: level == 4 ? 1.5px : Theme.border-width;
    border-color: tone.with-alpha(level == 4 ? 0.85 : 0.40);
    HorizontalLayout {
        padding-left: Scale.px(8px);
        padding-right: Scale.px(8px);
        spacing: Scale.px(4px);
        alignment: center;
        Text {
            text: root.level == 0 ? "✓" : root.level == 1 ? "●" : root.level == 2 ? "▲" : root.level == 3 ? "◆" : "×";
            font-size: Scale.font-xs;
            color: root.tone;
            vertical-alignment: center;
        }
        Text { text: root.label; font-size: Scale.font-xs; color: root.tone; vertical-alignment: center; }
    }
    Tooltip {
        WbTip {
            text: Tr.s(root.level == 0 ? "RiskTipSafe" : root.level == 1 ? "RiskTipLow" : root.level == 2 ? "RiskTipModerate"
                : root.level == 3 ? "RiskTipHigh" : "RiskTipExtreme");
        }
    }
}

// Tinted status pill.
export component WbPill inherits Rectangle {
    in property <string> text;
    in property <string> tone: "muted"; // success | danger | warning | accent | muted
    private property <color> c: tone == "success" ? Theme.success : tone == "danger" ? Theme.danger
        : tone == "warning" ? Theme.warning : tone == "accent" ? Theme.accent : Theme.text-muted;
    height: Scale.px(22px);
    border-radius: Scale.px(Theme.badge-radius);
    background: c.with-alpha(0.16);
    border-width: Theme.border-width;
    border-color: c.with-alpha(0.45);
    HorizontalLayout {
        padding-left: Scale.px(7px);
        padding-right: Scale.px(7px);
        Text { text: root.text; font-size: Scale.font-xs; color: root.c; vertical-alignment: center; overflow: elide; }
    }
}

// Standard view card. 1.7.0: staggered entrance right after a view switch (Fx.entering),
// hover lift (accent border + soft shadow) and an optional gradient `glow` border for key cards.
export component WbPanel inherits Rectangle {
    in property <bool> glow: false;
    in property <bool> hoverable: true;

    private property <bool> shown: true;
    private property <int> order: 0;
    private property <bool> hot: root.hoverable && hover.has-hover;
    // 3D depth layer (GPU renderer only, never with reduced motion): the card lifts toward the
    // viewer, a soft light spot follows the pointer and the shadow falls away from it (parallax).
    private property <bool> depth: Fx.gpu && !Theme.reduced-motion && root.hot;
    private property <float> px: root.width > 0 ? hover.mouse-x / root.width - 0.5 : 0;
    private property <float> py: root.height > 0 ? hover.mouse-y / root.height - 0.5 : 0;

    border-radius: Scale.px(Theme.card-radius);
    background: Theme.bg-card;
    border-width: Theme.border-width;
    border-color: root.glow ? transparent : root.hot ? Theme.border-accent : Theme.border;
    drop-shadow-blur: root.depth ? Scale.px(30px) : root.hot ? Scale.px(20px) : root.glow ? Scale.px(16px) : 0px;
    drop-shadow-offset-x: root.depth ? Scale.px(-10px) * root.px : 0px;
    drop-shadow-offset-y: root.depth ? Scale.px(10px) - Scale.px(8px) * root.py : root.hot ? Scale.px(4px) : 0px;
    drop-shadow-color: root.hot ? Theme.accent.with-alpha(Theme.dark ? 0.24 : 0.18)
        : root.glow ? Theme.accent.with-alpha(0.14) : Theme.accent.with-alpha(0);
    opacity: root.shown ? 1 : 0;
    transform-scale: !root.shown ? 0.97 : root.depth ? 1.012 : 1;
    animate opacity, transform-scale { duration: Theme.anim-enter; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
    animate border-color, drop-shadow-blur, drop-shadow-color, drop-shadow-offset-y { duration: Theme.anim; }
    animate drop-shadow-offset-x { duration: 90ms; }

    init => {
        if Fx.entering && !Theme.reduced-motion {
            root.order = Fx.stagger;
            Fx.stagger += 1;
            root.shown = false;
        }
    }
    Timer {
        interval: 20ms + min(root.order, 8) * 45ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }

    if root.glow : Rectangle {
        border-radius: root.border-radius;
        border-width: 1.5px;
        border-color: @linear-gradient(135deg, Theme.accent.with-alpha(0.85) 0%, Theme.sparkline-ram.with-alpha(0.40) 50%, Theme.accent.with-alpha(0.10) 100%);
    }
    // Pointer-tracked specular light (behind the content, clipped to the card shape).
    if root.depth : Rectangle {
        border-radius: root.border-radius;
        clip: true;
        Rectangle {
            width: max(root.width, root.height) * 1.4;
            height: self.width;
            x: hover.mouse-x - self.width / 2;
            y: hover.mouse-y - self.height / 2;
            background: @radial-gradient(circle, Theme.text-primary.with-alpha(Theme.dark ? 0.07 : 0.10) 0%, Theme.text-primary.with-alpha(0) 55%);
        }
    }
    // Wraps the content so hover stays true while the pointer is over child buttons.
    hover := TouchArea {
        @children
    }
}

// ui/components/in_progress_hud.slint
// Centered modal "IN PROGRESS" HUD (port of v1.6.1 in_progress_hud): orbit spinner, pulsing
// lightning badge, elapsed timer and wrapped live status. Click outside / Dismiss hides it
// (the operation keeps running in the background, exactly like v1.6.1).
import { Scale, Theme, Tr } from "../theme.slint";
import { AppStore } from "../stores/app.slint";

export component WbInProgressHud inherits Rectangle {
    background: Theme.scrim;
    private property <float> phase: Theme.reduced-motion ? 0 : mod(animation-tick() / 1ms, 1800) / 1800;

    TouchArea { clicked => { AppStore.dismiss-hud(); } }

    card := Rectangle {
        width: min(root.width - Scale.px(32px), Scale.px(420px));
        height: content.preferred-height;
        border-radius: Scale.px(Theme.card-radius);
        background: Theme.bg-card;
        border-width: 1.5px;
        border-color: Theme.border-accent;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow-lg;
        TouchArea {}

        content := VerticalLayout {
            padding: Scale.px(20px);
            spacing: Scale.px(12px);
            alignment: center;
            Rectangle {
                height: Scale.px(72px);
                // 10-dot orbital radar
                for i in 10 : Rectangle {
                    property <angle> a: (i / 10) * 360deg + root.phase * 360deg;
                    width: Scale.px(6px);
                    height: Scale.px(6px);
                    border-radius: self.width / 2;
                    x: parent.width / 2 + cos(a) * Scale.px(30px) - self.width / 2;
                    y: parent.height / 2 + sin(a) * Scale.px(30px) - self.height / 2;
                    background: Theme.accent.with-alpha(0.25 + 0.75 * (i / 10));
                }
                Rectangle {
                    width: Scale.px(36px);
                    height: Scale.px(36px);
                    border-radius: self.width / 2;
                    background: Theme.accent.with-alpha(0.18 + 0.12 * abs(sin(root.phase * 360deg)));
                    Text { text: "⚡"; font-size: Scale.font-lg; color: Theme.accent; }
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: Scale.px(6px);
                Text { text: Tr.s("HudInProgress"); font-size: Scale.font-xs; font-weight: 800; letter-spacing: 1.2px; color: Theme.accent; }
                if AppStore.hud-elapsed != "" : Text { text: "•"; font-size: Scale.font-xs; color: Theme.text-muted; }
                if AppStore.hud-elapsed != "" : Text { text: AppStore.hud-elapsed; font-size: Scale.font-xs; color: Theme.text-muted; }
            }
            Text {
                text: AppStore.hud-status == "" ? "Optimizing Windows..." : AppStore.hud-status;
                font-size: Scale.font-md;
                color: Theme.text-primary;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            Text {
                text: Tr.s("CloseBtn");
                font-size: Scale.font-2xs;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}

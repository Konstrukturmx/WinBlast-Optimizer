// ui/components/sparkline.slint
// Pure Slint 1.19 lightweight sparkline visualizer for live CPU, RAM, and GPU telemetry.

import { Scale, Theme } from "../theme.slint";

export component WbSparkline inherits Rectangle {
    in property <[float]> values: [];
    in property <color> stroke-color: Theme.accent;
    in property <color> fill-color: Theme.accent-subtle;
    in property <float> max-val: 100.0;
    in property <string> unit: "%";

    height: Scale.px(42px);
    min-width: Scale.px(80px);
    border-radius: Scale.radius-sm;
    background: Theme.bg-surface;
    clip: true;

    // Grid guide lines
    Rectangle {
        y: parent.height * 0.5;
        height: 1px;
        background: Theme.border-subtle;
    }

    // Sparkline bars representation (compatible across software and GPU renderers)
    HorizontalLayout {
        padding: Scale.space-2xs;
        spacing: Scale.space-2xs;
        alignment: stretch;

        for val in root.values: Rectangle {
            private property <float> normalized: clamp(val / max(1.0, root.max-val), 0.05, 1.0);
            horizontal-stretch: 1;
            y: parent.height - self.height;
            height: parent.height * normalized;
            border-radius: Scale.radius-xs;
            background: root.stroke-color;
            opacity: 0.85;

            animate height { duration: 150ms; easing: ease-out; }
        }
    }
}

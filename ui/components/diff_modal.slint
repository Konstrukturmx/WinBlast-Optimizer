// ui/components/diff_modal.slint
// Localized diff preview overlay: before -> after for every pending or inspected mutation
// (registry DWORD/SZ/binary/composite/dynamic, power cfg, services, tasks, AppX, features).
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { AppStore, DiffRowData } from "../stores/app.slint";
import { WbButton } from "button.slint";

export component WbDiffModal inherits Rectangle {
    background: Theme.scrim;
    TouchArea { clicked => { AppStore.close-diff(); } }

    Rectangle {
        width: min(root.width - Scale.px(32px), Scale.px(720px));
        height: min(root.height - Scale.px(48px), Scale.px(420px));
        border-radius: Scale.px(Theme.card-radius);
        background: Theme.bg-card;
        border-width: 1.5px;
        border-color: Theme.border-accent;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow-lg;
        TouchArea {}

        VerticalLayout {
            padding: Scale.px(14px);
            spacing: Scale.px(10px);
            HorizontalLayout {
                spacing: Scale.px(8px);
                Text {
                    text: AppStore.diff-title;
                    font-size: Scale.font-lg;
                    font-weight: 700;
                    color: Theme.accent;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                WbButton { variant: "secondary"; text: Tr.s("CloseBtn"); clicked => { AppStore.close-diff(); } }
            }
            if AppStore.diff-rows.length == 0 : Text {
                text: Tr.s("DiffModalEmpty");
                font-size: Scale.font-sm;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: Scale.px(8px);
                    alignment: start;
                    for r in AppStore.diff-rows : Rectangle {
                        border-radius: Scale.px(6px);
                        background: Theme.bg-primary;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: Scale.px(8px);
                            spacing: Scale.px(4px);
                            Text { text: r.header; font-size: Scale.font-sm; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
                            if r.is-pair : HorizontalLayout {
                                spacing: Scale.px(10px);
                                Text { text: r.left; font-size: Scale.font-xs; color: Theme.danger; wrap: word-wrap; horizontal-stretch: 1; }
                                Text { text: "→"; color: Theme.text-muted; vertical-alignment: center; }
                                Text { text: r.right; font-size: Scale.font-xs; color: Theme.success; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                            if !r.is-pair : Text {
                                text: r.summary;
                                font-size: Scale.font-xs;
                                color: r.tone == "success" ? Theme.success : r.tone == "danger" ? Theme.danger : Theme.warning;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

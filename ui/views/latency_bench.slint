// ui/views/latency_bench.slint
// WinBlast0 DPC & ISR Driver Latency Benchmark in Slint 1.19

import { Scale, Theme } from "../theme.slint";
import { WbButton } from "../components/button.slint";
import { WbCard } from "../components/card.slint";
import { WbBadge } from "../components/badge.slint";
import { WbProgressBar } from "../components/progress_bar.slint";
import { WbSparkline } from "../components/sparkline.slint";

export component LatencyBenchView inherits Flickable {
    in property <int> tier;
    in property <bool> is-monitoring: false;
    in property <float> current-latency-us: 42.0;
    in property <float> max-latency-us: 128.5;
    in property <float> avg-latency-us: 38.2;
    in property <[float]> latency-history: [35.0, 42.0, 38.0, 45.0, 128.5, 41.0, 39.0, 42.0, 36.0, 40.0];

    in property <string> offending-driver: "dxgkrnl.sys (DirectX Graphics Kernel)";
    in property <float> offending-driver-latency: 128.5;

    callback toggle-monitoring();
    callback reset-stats();

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: Scale.space-lg;
        spacing: Scale.space-md;

        // Header Card
        WbCard {
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: Scale.space-2xs;
                    Text {
                        text: "DPC & Interrupt Execution Latency";
                        font-size: Scale.font-xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "Microsecond-resolution driver Deferred Procedure Call (DPC) audio and frame-drop diagnostics.";
                        font-size: Scale.font-sm;
                        color: Theme.text-secondary;
                    }
                }

                HorizontalLayout {
                    spacing: Scale.space-sm;
                    WbButton {
                        variant: "ghost";
                        text: "Reset";
                        clicked => { root.reset-stats(); }
                    }
                    WbButton {
                        variant: root.is-monitoring ? "danger" : "primary";
                        text: root.is-monitoring ? "Stop Monitor" : "Start Monitor";
                        clicked => { root.toggle-monitoring(); }
                    }
                }
            }
        }

        // Latency Metric Gauges Row
        HorizontalLayout {
            spacing: Scale.space-md;

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "CURRENT DPC LATENCY"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text {
                        text: round(root.current-latency-us) + " µs";
                        font-size: Scale.font-2xl;
                        font-weight: 800;
                        color: root.current-latency-us >= 1000 ? Theme.high : (root.current-latency-us >= 500 ? Theme.moderate : Theme.safe);
                    }
                    Text { text: "Real-time tick latency"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "MAXIMUM SPIKE"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text {
                        text: round(root.max-latency-us) + " µs";
                        font-size: Scale.font-2xl;
                        font-weight: 800;
                        color: root.max-latency-us >= 1000 ? Theme.high : (root.max-latency-us >= 500 ? Theme.moderate : Theme.safe);
                    }
                    Text { text: "Peak worst-case latency"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "AVERAGE LATENCY"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text {
                        text: round(root.avg-latency-us) + " µs";
                        font-size: Scale.font-2xl;
                        font-weight: 800;
                        color: Theme.accent;
                    }
                    Text { text: "Rolling session mean"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }
        }

        // Live History Chart
        WbCard {
            VerticalLayout {
                spacing: Scale.space-sm;
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "REAL-TIME LATENCY TRACE"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    WbBadge {
                        text: root.max-latency-us < 500 ? "System Suitable for Real-Time Audio" : "Potential Audio Glitches / Stutters";
                        variant: root.max-latency-us < 500 ? "safe" : "moderate";
                        show-dot: true;
                    }
                }
                WbSparkline {
                    values: root.latency-history;
                    max-val: 200.0;
                    unit: "µs";
                    stroke-color: root.max-latency-us >= 1000 ? Theme.high : Theme.accent;
                }
            }
        }

        // Offending Driver Card
        WbCard {
            VerticalLayout {
                spacing: Scale.space-2xs;
                Text { text: "HIGHEST REPORTED ISR/DPC ROUTINE"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: root.offending-driver; font-size: Scale.font-md; font-weight: 600; color: Theme.text-primary; }
                    Text { text: round(root.offending-driver-latency) + " µs"; font-size: Scale.font-md; font-weight: 700; color: Theme.accent; }
                }
            }
        }
    }
}

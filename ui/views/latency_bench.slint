// ui/views/latency_bench.slint
// System & network latency benchmark (port of v1.6.1) with before/after comparison.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { LatencyStore, LatencyMetric } from "../stores/latency.slint";
import { WbButton } from "../components/button.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";

component MetricCell inherits VerticalLayout {
    in property <LatencyMetric> m;
    min-width: Scale.px(150px);
    horizontal-stretch: 1;
    spacing: Scale.px(2px);
    Text { text: m.label; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
    Text {
        text: m.now;
        font-size: Scale.font-lg;
        font-weight: 800;
        color: m.tone == "success" ? Theme.success : m.tone == "warning" ? Theme.warning : m.tone == "danger" ? Theme.danger : Theme.accent;
    }
    if m.was != "" : Text { text: m.was; font-size: Scale.font-2xs; color: Theme.text-muted; }
}

component Cell inherits VerticalLayout {
    in property <string> k;
    in property <string> v;
    min-width: Scale.px(70px);
    Text { text: root.k; font-size: Scale.font-2xs; color: Theme.text-muted; }
    Text { text: root.v; font-size: Scale.font-xs; font-weight: 600; color: Theme.text-primary; }
}

export component LatencyBenchView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            VerticalLayout {
                spacing: Scale.px(4px);
                Text { text: Tr.s("LatencyTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                Text { text: Tr.s("LatencySub"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
            }
            FlexboxLayout {
                spacing: Scale.px(6px);
                WbButton {
                    variant: "primary";
                    text: LatencyStore.running ? Tr.s("RunningTest") : Tr.s("RunLatencyTest");
                    enabled: !LatencyStore.running;
                    loading: LatencyStore.running;
                    clicked => { LatencyStore.run(); }
                }
                WbButton { variant: "secondary"; text: Tr.s("SaveBeforeBaselineBtn"); enabled: !LatencyStore.running; clicked => { LatencyStore.save-baseline(); } }
                WbButton { variant: "secondary"; text: Tr.s("LatencyClearBtn"); clicked => { LatencyStore.clear(); } }
            }

            if LatencyStore.has-comparison : WbPanel {
                FlexboxLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(14px);
                    alignment: stretch;
                    for m in LatencyStore.comparison : MetricCell { m: m; }
                }
            }

            if !LatencyStore.has-result : WbPanel {
                height: Scale.px(72px);
                Text {
                    text: LatencyStore.running ? Tr.s("LatencyRunningText") : Tr.s("NoLatencyRunYet");
                    font-size: Scale.font-sm;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
            if LatencyStore.has-result : WbPanel {
                FlexboxLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(14px);
                    alignment: stretch;
                    for m in LatencyStore.kpis : MetricCell { m: m; }
                }
            }
            for t in LatencyStore.targets : WbPanel {
                FlexboxLayout {
                    padding: Scale.px(10px);
                    spacing: Scale.px(12px);
                    alignment: stretch;
                    cross-axis-alignment: center;
                    Text { text: t.name; font-size: Scale.font-sm; font-weight: 600; color: Theme.text-primary; min-width: Scale.px(160px); horizontal-stretch: 1; }
                    WbPill { text: t.loss; tone: t.loss-ok ? "success" : "danger"; }
                    Cell { k: Tr.s("MinLabel"); v: t.min; }
                    Cell { k: Tr.s("AvgLabel"); v: t.avg; }
                    Cell { k: Tr.s("MaxLabel"); v: t.max; }
                    Cell { k: Tr.s("JitterLabel"); v: t.jitter; }
                }
            }
        }
    }
}

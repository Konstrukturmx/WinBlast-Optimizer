// ui/views/fps_benchmark.slint
// FPS reference table (port of v1.6.1 fps_benchmark). The figures are a static reference catalog,
// never presented as measurements of this PC.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { GamingStore, FpsRow } from "../stores/gaming.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";

component Stat inherits VerticalLayout {
    in property <string> k;
    in property <string> v;
    in property <color> c: Theme.text-primary;
    min-width: Scale.px(150px);
    horizontal-stretch: 1;
    spacing: Scale.px(2px);
    Text { text: root.k; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
    Text { text: root.v; font-size: Scale.font-sm; font-weight: 700; color: root.c; wrap: word-wrap; }
}

export component FpsBenchmarkBody inherits VerticalLayout {
    in property <int> tier;
    spacing: Scale.px(10px);
    alignment: start;

    VerticalLayout {
        spacing: Scale.px(4px);
        Text { text: Tr.s("FpsBenchTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
        Text { text: Tr.s("FpsReferenceNotice"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
    }
    for f in GamingStore.fps : WbPanel {
        VerticalLayout {
            padding: Scale.px(12px);
            spacing: Scale.px(8px);
            HorizontalLayout {
                spacing: Scale.px(8px);
                Text { text: f.icon; font-size: Scale.font-lg; vertical-alignment: center; }
                Text { text: f.title; font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                WbPill { text: f.gain; tone: "success"; }
            }
            FlexboxLayout {
                spacing: Scale.px(12px);
                alignment: stretch;
                Stat { k: Tr.s("FpsBenchAvgFps"); v: f.avg; }
                Stat { k: Tr.s("FpsOnePctLow"); v: f.low; c: Theme.success; }
                Stat { k: Tr.s("FpsBenchInputLatencyReduction"); v: f.latency; c: Theme.accent; }
            }
        }
    }
}

export component FpsBenchmarkView inherits Rectangle {
    in property <int> tier;
    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            alignment: start;
            FpsBenchmarkBody { tier: root.tier; }
        }
    }
}

// ui/views/fault_diagnostics.slint
// WinBlast0 Windows Event Log BSOD & Hardware Error Scanner in Slint 1.19

import { Scale, Theme } from "../theme.slint";
import { WbButton } from "../components/button.slint";
import { WbCard } from "../components/card.slint";
import { WbBadge } from "../components/badge.slint";

export struct CrashEventItem {
    id: string,
    event-type: string,       // "BSOD BugCheck" | "WHEA Hardware Error" | "Application Crash"
    source: string,
    time-text: string,
    error-code: string,
    summary: string,
}

export component FaultDiagnosticsView inherits Flickable {
    in property <int> bsod-count: 0;
    in property <int> whea-count: 0;
    in property <int> app-crash-count: 2;

    in property <[CrashEventItem]> events: [];

    callback scan-events-clicked();
    callback clear-event-logs();

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: Scale.space-lg;
        spacing: Scale.space-md;

        // Header Card
        WbCard {
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: Scale.space-2xs;
                    Text {
                        text: "System Stability & Crash Fault Diagnostics";
                        font-size: Scale.font-xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "Audit Windows Event Log for Kernel-Power 41 (BSOD), WHEA-Logger CPU/PCIe bus parity errors, and WER fault dumps.";
                        font-size: Scale.font-sm;
                        color: Theme.text-secondary;
                    }
                }

                HorizontalLayout {
                    spacing: Scale.space-sm;
                    WbButton {
                        variant: "ghost";
                        text: "Scan Logs";
                        clicked => { root.scan-events-clicked(); }
                    }
                }
            }
        }

        // Summary Badges Row
        HorizontalLayout {
            spacing: Scale.space-md;

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "KERNEL BSOD BUGCHECKS"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text { text: root.bsod-count + ""; font-size: Scale.font-2xl; font-weight: 800; color: root.bsod-count > 0 ? Theme.high : Theme.safe; }
                    Text { text: root.bsod-count == 0 ? "Zero kernel blue screens" : "Critical crashes recorded"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "WHEA HARDWARE ERRORS"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text { text: root.whea-count + ""; font-size: Scale.font-2xl; font-weight: 800; color: root.whea-count > 0 ? Theme.moderate : Theme.safe; }
                    Text { text: root.whea-count == 0 ? "Zero CPU/PCIe bus errors" : "Unstable core/fabric detected"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "APPLICATION FAULTS"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text { text: root.app-crash-count + ""; font-size: Scale.font-2xl; font-weight: 800; color: Theme.accent; }
                    Text { text: "User-space process aborts"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }
        }

        // Events List
        VerticalLayout {
            spacing: Scale.space-xs;

            for ev in root.events: WbCard {
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: Scale.space-2xs;
                        HorizontalLayout {
                            spacing: Scale.space-sm;
                            Text {
                                text: ev.event-type;
                                font-size: Scale.font-md;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }
                            WbBadge {
                                text: ev.error-code;
                                variant: ev.event-type == "BSOD BugCheck" ? "high" : "moderate";
                            }
                        }
                        Text {
                            text: ev.summary + " — " + ev.time-text + " (" + ev.source + ")";
                            font-size: Scale.font-xs;
                            color: Theme.text-secondary;
                        }
                    }
                }
            }
        }
    }
}

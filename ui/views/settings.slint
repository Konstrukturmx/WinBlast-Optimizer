// ui/views/settings.slint
// Settings (checklist E4): language, appearance, motion and how changes are applied, in one
// place. These used to be split between the top bar overflow and Support & About.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr, Fx } from "../theme.slint";
import { AppStore } from "../stores/app.slint";
import { WbButton } from "../components/button.slint";
import { WbChip, WbSegmented } from "../components/chip.slint";
import { WbPill, WbPanel, WbToggle } from "../components/toggle.slint";

component Note inherits Text {
    font-size: Scale.font-xs;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

component SectionTitle inherits Text {
    font-size: Scale.font-md;
    font-weight: 700;
    color: Theme.text-primary;
    wrap: word-wrap;
}

export component SettingsView inherits Rectangle {
    in property <int> tier;
    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            VerticalLayout {
                spacing: Scale.px(4px);
                Text { text: Tr.s("SettingsTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                Text { text: Tr.s("SettingsSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(8px);
                    SectionTitle { text: Tr.s("SettingsLanguage"); }
                    FlexboxLayout {
                        spacing: Scale.px(6px);
                        for l[i] in AppStore.languages : WbChip {
                            text: l.label;
                            active: l.selected;
                            clicked => { AppStore.set-language(i); }
                        }
                    }
                }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(10px);
                    SectionTitle { text: Tr.s("SettingsAppearance"); }
                    HorizontalLayout {
                        spacing: Scale.px(10px);
                        Text { text: Tr.s("SettingsThemeMode"); font-size: Scale.font-sm; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        WbToggle {
                            on: AppStore.theme-dark;
                            accessible-name: Tr.s("SettingsThemeMode");
                            clicked => { AppStore.toggle-theme-mode(); }
                        }
                    }
                    Note { text: Tr.s("SettingsColorScheme"); }
                    FlexboxLayout {
                        spacing: Scale.px(6px);
                        for c[i] in AppStore.color-schemes : WbChip {
                            text: c.label;
                            active: c.selected;
                            clicked => { AppStore.set-color-scheme(i); }
                        }
                    }
                    Note { text: Tr.s("SettingsZoom"); }
                    HorizontalLayout {
                        spacing: Scale.px(6px);
                        alignment: start;
                        WbButton { variant: "secondary"; text: "−"; clicked => { AppStore.set-zoom(AppStore.zoom - 0.1); } }
                        Text { text: round(AppStore.zoom * 100) + " %"; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; min-width: Scale.px(56px); horizontal-alignment: center; }
                        WbButton { variant: "secondary"; text: "+"; clicked => { AppStore.set-zoom(AppStore.zoom + 0.1); } }
                        WbButton { variant: "ghost"; text: Tr.s("SettingsZoomReset"); clicked => { AppStore.set-zoom(1.0); } }
                    }
                }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(8px);
                    Text { text: Tr.s("AboutStudioTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                    Note { text: Tr.s("AboutStudioSubtitle"); }
                    HorizontalLayout {
                        spacing: Scale.px(10px);
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Scale.px(2px);
                            Text { text: Tr.s("ReducedMotionLabel"); font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                            Note { text: Tr.s("ReducedMotionDesc"); }
                        }
                        VerticalLayout {
                            alignment: center;
                            WbToggle {
                                on: Theme.reduced-motion;
                                accessible-name: Tr.s("ReducedMotionLabel");
                                clicked => { AppStore.toggle-reduced-motion(); }
                            }
                        }
                    }
                    // Honest status of the GPU-only depth layer (Fx.gpu comes from a DXGI probe).
                    Note {
                        text: Fx.gpu && !Theme.reduced-motion ? Tr.s("AboutDepthOn") : Tr.s("AboutDepthOff");
                        color: Fx.gpu && !Theme.reduced-motion ? Theme.success : Theme.text-muted;
                    }
                    FlexboxLayout {
                        spacing: Scale.px(8px);
                        alignment: stretch;
                        for st[i] in AppStore.theme-styles : Rectangle {
                            min-width: Scale.px(170px);
                            horizontal-stretch: 1;
                            border-radius: Scale.px(Theme.card-radius);
                            background: st.selected ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.bg-card-hover : Theme.bg-card;
                            border-width: Theme.border-width;
                            border-color: st.selected ? Theme.accent : Theme.border;
                            ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppStore.set-theme-style(i); }
                            }
                            VerticalLayout {
                                padding: Scale.px(10px);
                                spacing: Scale.px(4px);
                                HorizontalLayout {
                                    spacing: Scale.px(6px);
                                    Text { text: st.label; font-size: Scale.font-sm; font-weight: 700; color: st.selected ? Theme.accent : Theme.text-primary; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    if st.selected : WbPill { text: Tr.s("AboutActiveBadge"); tone: "accent"; }
                                }
                                if st.detail != "" : Text { text: st.detail; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(8px);
                    SectionTitle { text: Tr.s("SettingsApplyMode"); }
                    HorizontalLayout {
                        alignment: start;
                        WbSegmented {
                            left-text: Tr.s("HeaderInstant");
                            right-text: Tr.s("HeaderNormal");
                            left-active: AppStore.engine-instant;
                            left-clicked => { AppStore.set-engine-instant(true); }
                            right-clicked => { AppStore.set-engine-instant(false); }
                        }
                    }
                    Note { text: AppStore.engine-instant ? Tr.s("SettingsInstantDesc") : Tr.s("SettingsNormalDesc"); }
                }
            }
        }
    }
}

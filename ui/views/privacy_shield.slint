// ui/views/privacy_shield.slint
// Privacy Shield (port of v1.6.1): stats, hosts & services telemetry audit, privacy switches.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { PrivacyStore } from "../stores/privacy.slint";
import { MatrixStore } from "../stores/matrix.slint";
import { WbButton } from "../components/button.slint";
import { WbToggle, WbRiskBadge, WbPill, WbPanel } from "../components/toggle.slint";

component Stat inherits VerticalLayout {
    in property <int> value;
    in property <string> label;
    in property <color> tone;
    min-width: Scale.px(130px);
    horizontal-stretch: 1;
    alignment: center;
    Text { text: root.value; font-size: Scale.font-xl; font-weight: 800; color: root.tone; horizontal-alignment: center; }
    Text { text: root.label; font-size: Scale.font-xs; color: Theme.text-muted; horizontal-alignment: center; wrap: word-wrap; }
}

export component PrivacyShieldView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            VerticalLayout {
                spacing: Scale.px(4px);
                Text { text: Tr.s("PrivacyTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                Text { text: Tr.s("PrivacySub"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
            }

            WbPanel {
                FlexboxLayout {
                    padding: Scale.px(Theme.card-padding);
                    spacing: Scale.px(16px);
                    alignment: stretch;
                    Stat { value: PrivacyStore.optimized; label: Tr.s("PrivacyBlockedStat"); tone: Theme.success; }
                    Stat { value: PrivacyStore.not-optimized; label: Tr.s("PrivacyActiveStat"); tone: Theme.danger; }
                    Stat { value: PrivacyStore.partial; label: Tr.s("PrivacyPartialStat"); tone: Theme.warning; }
                }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(8px);
                    HorizontalLayout {
                        spacing: Scale.px(8px);
                        Text { text: Tr.s("HostsAuditTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        WbButton { variant: "secondary"; text: Tr.s("RunAuditBtn"); clicked => { PrivacyStore.run-audit(); } }
                    }
                    if PrivacyStore.audit-available : FlexboxLayout {
                        spacing: Scale.px(10px);
                        cross-axis-alignment: center;
                        Text { text: PrivacyStore.hosts-status; font-size: Scale.font-sm; color: Theme.text-secondary; min-width: Scale.px(180px); }
                        WbButton {
                            variant: "primary";
                            text: PrivacyStore.hosts-inflight ? Tr.s("BusyWorking") : Tr.s("BlockTelemetryHostsBtn");
                            enabled: !PrivacyStore.hosts-inflight && !PrivacyStore.busy;
                            loading: PrivacyStore.hosts-inflight;
                            clicked => { PrivacyStore.block-hosts(); }
                        }
                    }
                    if PrivacyStore.audit-available : FlexboxLayout {
                        spacing: Scale.px(10px);
                        cross-axis-alignment: center;
                        Text { text: PrivacyStore.services-status; font-size: Scale.font-sm; color: Theme.text-secondary; min-width: Scale.px(180px); }
                        WbButton {
                            variant: "danger";
                            text: PrivacyStore.services-inflight ? Tr.s("BusyWorking") : Tr.s("NeutralizeServicesBtn");
                            enabled: !PrivacyStore.services-inflight && !PrivacyStore.busy;
                            loading: PrivacyStore.services-inflight;
                            clicked => { PrivacyStore.neutralize-services(); }
                        }
                    }
                }
            }

            FlexboxLayout {
                spacing: Scale.px(6px);
                WbButton { variant: "secondary"; text: Tr.s("SelectAll"); clicked => { PrivacyStore.select-all(); } }
                WbButton { variant: "secondary"; text: Tr.s("DeselectAll"); clicked => { PrivacyStore.deselect-all(); } }
                WbButton {
                    variant: "primary";
                    text: PrivacyStore.is-applying ? Tr.s("BusyWorking")
                        : PrivacyStore.selected-count == 0 ? Tr.s("ApplySelected")
                        : Tr.s("ApplySelected") + " (" + PrivacyStore.selected-count + ")";
                    enabled: !PrivacyStore.is-applying && !PrivacyStore.busy;
                    clicked => { PrivacyStore.apply-selected(); }
                }
            }

            if PrivacyStore.rows.length == 0 : Text {
                text: PrivacyStore.is-scanning ? Tr.s("ScanningEvaluating") : Tr.s("NoEligibleTweaks");
                font-size: Scale.font-sm;
                color: Theme.text-muted;
            }
            for r in PrivacyStore.rows : WbPanel {
                border-color: r.active ? Theme.accent.with-alpha(0.35) : Theme.border;
                FlexboxLayout {
                    padding: Scale.px(10px);
                    spacing: Scale.px(10px);
                    alignment: stretch;
                    cross-axis-alignment: center;
                    if r.not-applicable : WbPill { text: Tr.s("StatusNotApplicable"); }
                    if !r.not-applicable : WbToggle {
                        on: r.active;
                        busy: r.in-flight;
                        accessible-name: r.title;
                        clicked => { MatrixStore.switch-clicked(r.id); }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: Scale.px(200px);
                        Text { text: r.title; font-size: Scale.font-sm; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
                        Text { text: r.category-label; font-size: Scale.font-2xs; color: Theme.text-muted; }
                    }
                    WbRiskBadge { level: r.risk-level; label: r.risk-label; }
                    VerticalLayout {
                        min-width: Scale.px(150px);
                        Text {
                            text: r.state-text;
                            font-size: Scale.font-xs;
                            font-weight: 600;
                            color: r.state-tone == "success" ? Theme.success : r.state-tone == "danger" ? Theme.danger : r.state-tone == "warning" ? Theme.warning : Theme.text-muted;
                        }
                        Text { text: r.detail; font-size: Scale.font-2xs; color: Theme.text-muted; overflow: elide; }
                    }
                }
            }
        }
    }
}

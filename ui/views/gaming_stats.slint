// ui/views/gaming_stats.slint
// Gaming & Performance hub (port of v1.6.1 gaming_stats): live monitor + FPS / profiles / overlay /
// suitability sub-tabs. The live monitor only shows what is actually detected; frame-time capture
// is not implemented and says so (v1.6.1 displayed invented frame pacing / DirectX values).
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { GamingStore } from "../stores/gaming.slint";
import { WbButton } from "../components/button.slint";
import { WbChip } from "../components/chip.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";

component InfoCard inherits WbPanel {
    in property <string> label;
    in property <string> value;
    in property <string> note;
    in property <color> c: Theme.text-primary;
    min-width: Scale.px(220px);
    horizontal-stretch: 1;
    VerticalLayout {
        padding: Scale.px(12px);
        spacing: Scale.px(4px);
        Text { text: root.label; font-size: Scale.font-xs; color: Theme.text-secondary; wrap: word-wrap; }
        Text { text: root.value; font-size: Scale.font-md; font-weight: 700; color: root.c; wrap: word-wrap; }
        if root.note != "" : Text { text: root.note; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
    }
}

component LiveMonitorBody inherits VerticalLayout {
    in property <int> tier;
    spacing: Scale.px(10px);
    alignment: start;
    FlexboxLayout {
        spacing: Scale.px(10px);
        alignment: stretch;
        InfoCard {
            label: Tr.s("GamingStatsActiveProcess");
            value: GamingStore.detected-game;
            note: Tr.s("GamingDetectHint");
            c: Theme.accent;
        }
        InfoCard {
            label: Tr.s("GamingStatsFpsTelemetry");
            value: Tr.s("GamingNotMeasured");
            note: "";
            c: Theme.text-muted;
        }
    }
    WbPanel {
        FlexboxLayout {
            padding: Scale.px(12px);
            spacing: Scale.px(10px);
            alignment: stretch;
            cross-axis-alignment: center;
            Text { text: Tr.s("GamingStatsWddmScheduling"); font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; min-width: Scale.px(200px); horizontal-stretch: 1; wrap: word-wrap; }
            WbPill { text: GamingStore.hags-text; tone: GamingStore.hags-on ? "success" : "muted"; }
        }
    }
}

export component GamingStatsView inherits Rectangle {
    in property <int> tier;
    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;
            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                cross-axis-alignment: center;
                VerticalLayout {
                    min-width: Scale.px(200px);
                    horizontal-stretch: 1;
                    spacing: Scale.px(4px);
                    Text { text: Tr.s("NavGamingHub"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                    Text { text: Tr.s("GamingStatsFooterDesc"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                }
                WbButton {
                    variant: "primary";
                    text: Tr.s("GamingStatsRefreshBtn");
                    enabled: !GamingStore.probing;
                    loading: GamingStore.probing;
                    clicked => { GamingStore.refresh(); }
                }
            }
            LiveMonitorBody { tier: root.tier; }
        }
    }
}

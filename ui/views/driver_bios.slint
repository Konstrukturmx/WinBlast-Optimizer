// ui/views/driver_bios.slint
// Driver & BIOS (port of v1.6.1): online driver center, motherboard / firmware / Secure Boot,
// GPU display-driver stack.
import { ListView, ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { DriverStore } from "../stores/drivers.slint";
import { WbChip } from "../components/chip.slint";
import { WbButton } from "../components/button.slint";
import { WbSearchInput } from "../components/search_input.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";
import { WbSection } from "../components/kv.slint";
import { WbShimmer } from "../components/fx.slint";

export component DriverBiosView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            FlexboxLayout {
                spacing: Scale.px(8px);
                alignment: stretch;
                cross-axis-alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: Scale.px(220px);
                    Text { text: Tr.s("NavDriverBios"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                    Text { text: Tr.s("DriverBiosSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                }
                WbButton {
                    variant: "primary";
                    text: DriverStore.scanning ? Tr.s("Scanning") : Tr.s("DriverScanOnline");
                    enabled: !DriverStore.scanning;
                    loading: DriverStore.scanning;
                    clicked => { DriverStore.scan-online(); }
                }
                // G4: the "test driver" button ran pnputil /scan-devices on the user's PC and reported a
                // fake install; it was test scaffolding, not a feature.
                WbButton { variant: "secondary"; text: Tr.s("DriverRescanBios"); loading: DriverStore.bios-scanning; clicked => { DriverStore.rescan-bios(); } }
            }

            WbSection {
                title: "🌐 " + Tr.s("DriverBiosOnlineUpdateTitle");
                Text { text: DriverStore.devices-scanned; font-size: Scale.font-xs; color: Theme.text-muted; }
                WbSearchInput {
                    placeholder: Tr.s("DriverSearchPlaceholder");
                    text: DriverStore.search;
                    changed(t) => { DriverStore.search-edited(t); }
                }
                FlexboxLayout {
                    spacing: Scale.px(6px);
                    WbChip { text: Tr.s("DriverFilterAll"); active: DriverStore.category == ""; clicked => { DriverStore.set-category(""); } }
                    WbChip { text: Tr.s("DriverFilterDisplay"); active: DriverStore.category == "Display"; clicked => { DriverStore.set-category("Display"); } }
                    WbChip { text: Tr.s("DriverFilterNetwork"); active: DriverStore.category == "Network"; clicked => { DriverStore.set-category("Network"); } }
                    WbChip { text: Tr.s("DriverFilterAudio"); active: DriverStore.category == "Audio"; clicked => { DriverStore.set-category("Audio"); } }
                    WbChip { text: Tr.s("DriverFilterStorage"); active: DriverStore.category == "Storage"; clicked => { DriverStore.set-category("Storage"); } }
                    WbChip { text: Tr.s("DriverCatChipset"); active: DriverStore.category == "Chipset"; clicked => { DriverStore.set-category("Chipset"); } }
                    WbChip { text: "🔌 USB"; active: DriverStore.category == "Usb"; clicked => { DriverStore.set-category("Usb"); } }
                    WbChip { text: "🔷 Bluetooth"; active: DriverStore.category == "Bluetooth"; clicked => { DriverStore.set-category("Bluetooth"); } }
                }
                if DriverStore.total == 0 : Text {
                    text: DriverStore.scanning ? Tr.s("DriverScanningCatalogs") : Tr.s("DriverScanHint");
                    font-size: Scale.font-sm;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                if DriverStore.total > 0 && DriverStore.drivers.length == 0 : Text { text: Tr.s("DriverBiosNoDevicesFound"); font-size: Scale.font-sm; color: Theme.text-muted; }
                if DriverStore.drivers.length > 0 : ListView {
                    height: min(Scale.px(380px), DriverStore.drivers.length * Scale.px(92px));
                    for d in DriverStore.drivers : VerticalLayout {
                        padding-bottom: Scale.px(6px);
                        Rectangle {
                            border-radius: Scale.px(Theme.btn-radius);
                            background: Theme.bg-primary;
                            FlexboxLayout {
                                padding: Scale.px(10px);
                                spacing: Scale.px(10px);
                                alignment: stretch;
                                cross-axis-alignment: center;
                                Text { text: d.icon; font-size: Scale.font-lg; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: Scale.px(220px);
                                    Text { text: d.name; font-size: Scale.font-sm; font-weight: 600; color: Theme.text-primary; overflow: elide; }
                                    Text { text: d.details; font-size: Scale.font-2xs; color: Theme.text-muted; overflow: elide; }
                                    Text { text: d.versions; font-size: Scale.font-2xs; color: Theme.text-secondary; }
                                    Text { text: d.date; font-size: Scale.font-2xs; color: Theme.text-muted; }
                                }
                                WbPill { text: d.whql ? "✓ WHQL" : "Unverified"; tone: d.whql ? "success" : "muted"; }
                                WbPill { text: d.badge; tone: d.badge-tone; }
                                WbChip { text: Tr.s("DriverBackupBtn"); enabled: !d.busy && !DriverStore.any-in-flight; clicked => { DriverStore.backup(d.id); } }
                                WbChip {
                                    text: d.busy ? Tr.s("DriverInstalling") : d.update ? Tr.s("DriverDownloadInstall") : "Verify / Update";
                                    tone: d.update ? "accent" : "neutral";
                                    enabled: !d.busy && !DriverStore.any-in-flight;
                                    clicked => { DriverStore.install(d.id); }
                                }
                            }
                        }
                    }
                }
            }

            FlexboxLayout {
                spacing: Scale.px(12px);
                alignment: stretch;
                WbSection {
                    min-width: Scale.px(260px);
                    horizontal-stretch: 1;
                    title: "🎛️ " + Tr.s("DriverBiosMotherboardSection");
                    Text { text: DriverStore.board-title; font-size: Scale.font-md; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
                    if DriverStore.board-sub != "" : Text { text: DriverStore.board-sub; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                }
                WbSection {
                    min-width: Scale.px(260px);
                    horizontal-stretch: 1;
                    title: "💾 " + Tr.s("DriverBiosFirmwareSection");
                    Text { text: DriverStore.firmware-title; font-size: Scale.font-md; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
                    if DriverStore.firmware-sub != "" : Text { text: DriverStore.firmware-sub; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                    if DriverStore.bios-loaded : WbPill {
                        text: DriverStore.secure-boot ? Tr.s("SecureBootActive") : Tr.s("SecureBootDisabled");
                        tone: DriverStore.secure-boot ? "success" : "warning";
                    }
                }
            }

            WbSection {
                title: "🎮 " + Tr.s("DriverBiosGpuDriversSection");
                if DriverStore.display-drivers.length == 0 && DriverStore.bios-scanning : WbShimmer { lines: 2; }
                if DriverStore.display-drivers.length == 0 && !DriverStore.bios-scanning : Text { text: "—"; color: Theme.text-muted; }
                for g in DriverStore.display-drivers : Rectangle {
                    border-radius: Scale.px(Theme.btn-radius);
                    background: Theme.bg-primary;
                    FlexboxLayout {
                        padding: Scale.px(8px);
                        spacing: Scale.px(10px);
                        alignment: stretch;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: Scale.px(220px);
                            Text { text: g.name; font-size: Scale.font-sm; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
                            Text { text: g.provider; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
                        }
                        VerticalLayout {
                            Text { text: g.version; font-size: Scale.font-xs; color: Theme.text-secondary; }
                            Text { text: g.date; font-size: Scale.font-2xs; color: Theme.text-muted; }
                        }
                    }
                }
            }
        }
    }
}

// ui/views/network_diag.slint
// WinBlast0 Network Diagnostics, Ping Jitter & MTU Optimizer in Slint 1.19

import { Scale, Theme } from "../theme.slint";
import { WbButton } from "../components/button.slint";
import { WbCard } from "../components/card.slint";
import { WbBadge } from "../components/badge.slint";
import { WbSparkline } from "../components/sparkline.slint";

export component NetworkDiagView inherits Flickable {
    in property <int> tier;
    in property <bool> is-testing: false;
    in property <string> adapter-name: "Intel(R) Ethernet Controller I225-V #2";
    in property <int> current-mtu: 1500;
    in property <float> ping-ms: 14.2;
    in property <float> jitter-ms: 1.1;
    in property <float> packet-loss-pct: 0.0;
    in property <[float]> ping-history: [14.0, 15.0, 14.2, 13.9, 14.5, 14.1, 14.0, 14.3, 14.2, 14.2];

    callback start-test();
    callback optimize-tcp-stack();
    callback flush-dns();

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: Scale.space-lg;
        spacing: Scale.space-md;

        // Header Card
        WbCard {
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: Scale.space-2xs;
                    Text {
                        text: "Network Latency & TCP Stack Tuning";
                        font-size: Scale.font-xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "ICMP jitter measurement, Nagle's algorithm disablement, and DNS cache optimizer.";
                        font-size: Scale.font-sm;
                        color: Theme.text-secondary;
                    }
                }

                HorizontalLayout {
                    spacing: Scale.space-sm;
                    WbButton {
                        variant: "ghost";
                        text: "Flush DNS";
                        clicked => { root.flush-dns(); }
                    }
                    WbButton {
                        variant: "secondary";
                        text: "Optimize TCP";
                        clicked => { root.optimize-tcp-stack(); }
                    }
                    WbButton {
                        variant: "primary";
                        text: root.is-testing ? "Testing..." : "Run Test";
                        loading: root.is-testing;
                        clicked => { root.start-test(); }
                    }
                }
            }
        }

        // Metrics Gauges Row
        HorizontalLayout {
            spacing: Scale.space-md;

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "GATEWAY PING"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text {
                        text: round(root.ping-ms) + " ms";
                        font-size: Scale.font-2xl;
                        font-weight: 800;
                        color: root.ping-ms >= 50 ? Theme.moderate : Theme.safe;
                    }
                    Text { text: "Round-trip response time"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "JITTER"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text {
                        text: round(root.jitter-ms) + " ms";
                        font-size: Scale.font-2xl;
                        font-weight: 800;
                        color: root.jitter-ms >= 5 ? Theme.moderate : Theme.safe;
                    }
                    Text { text: "Packet delivery variance"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "PACKET LOSS"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text {
                        text: root.packet-loss-pct + "%";
                        font-size: Scale.font-2xl;
                        font-weight: 800;
                        color: root.packet-loss-pct > 0 ? Theme.danger : Theme.safe;
                    }
                    Text { text: "Unacknowledged packets"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }
        }

        // Ping History Sparkline Card
        WbCard {
            VerticalLayout {
                spacing: Scale.space-sm;
                Text { text: "LIVE PING LATENCY TRACE"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                WbSparkline {
                    values: root.ping-history;
                    max-val: 50.0;
                    unit: "ms";
                    stroke-color: Theme.accent;
                }
            }
        }
    }
}

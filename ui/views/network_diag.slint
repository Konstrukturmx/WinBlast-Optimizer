// ui/views/network_diag.slint
// Network diagnostics (port of v1.6.1 network_diag): real adapter / TCP registry state, DNS
// round-trip probes on a worker, and DNS actions whose real outcome is reported.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { NetworkStore, DnsRow } from "../stores/gaming.slint";
import { WbButton } from "../components/button.slint";
import { WbChip } from "../components/chip.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";

component StateCard inherits WbPanel {
    in property <string> label;
    in property <bool> ok;
    min-width: Scale.px(200px);
    horizontal-stretch: 1;
    VerticalLayout {
        padding: Scale.px(12px);
        spacing: Scale.px(4px);
        Text { text: root.label; font-size: Scale.font-xs; color: Theme.text-secondary; wrap: word-wrap; }
        Text {
            text: root.ok ? Tr.s("NetDiagLowLatencyBadge") : Tr.s("NetDiagDefaultLatencyBadge");
            font-size: Scale.font-md;
            font-weight: 700;
            color: root.ok ? Theme.success : Theme.text-muted;
        }
    }
}

export component NetworkDiagView inherits Rectangle {
    in property <int> tier;
    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            VerticalLayout {
                spacing: Scale.px(4px);
                Text { text: Tr.s("NetDiagTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                Text { text: Tr.s("NetDiagSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
            }
            FlexboxLayout {
                spacing: Scale.px(6px);
                WbButton {
                    variant: "primary";
                    text: Tr.s("NetDiagPingBtn");
                    enabled: !NetworkStore.probing;
                    loading: NetworkStore.probing;
                    clicked => { NetworkStore.ping(); }
                }
                WbButton { variant: "secondary"; text: Tr.s("NetDiagResetDnsBtn"); enabled: !NetworkStore.busy; loading: NetworkStore.busy; clicked => { NetworkStore.reset-dns(); } }
                WbButton { variant: "secondary"; text: Tr.s("NetDiagFlushDnsBtn"); enabled: !NetworkStore.busy; clicked => { NetworkStore.flush-dns(); } }
            }
            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                WbPanel {
                    min-width: Scale.px(220px);
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Scale.px(12px);
                        spacing: Scale.px(4px);
                        Text { text: Tr.s("NetDiagAdapterLabel"); font-size: Scale.font-xs; color: Theme.text-secondary; wrap: word-wrap; }
                        Text { text: NetworkStore.adapter; font-size: Scale.font-md; font-weight: 700; color: Theme.accent; wrap: word-wrap; }
                        Text { text: NetworkStore.ip-mtu; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
                    }
                }
                StateCard { label: Tr.s("NetDiagTcpAckLabel"); ok: NetworkStore.ack-optimized; }
                StateCard { label: Tr.s("NetDiagTcpNoDelayLabel"); ok: NetworkStore.nodelay-optimized; }
            }
            HorizontalLayout {
                spacing: Scale.px(8px);
                Text { text: "🌐 " + Tr.s("NetDiagDnsBenchmarkTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center; }
                WbPill { text: NetworkStore.tracked; tone: "accent"; }
            }
            for d in NetworkStore.probes : WbPanel {
                FlexboxLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(10px);
                    alignment: stretch;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        min-width: Scale.px(220px);
                        horizontal-stretch: 1;
                        spacing: Scale.px(2px);
                        HorizontalLayout {
                            spacing: Scale.px(6px);
                            Text { text: d.name; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                            WbPill { text: d.category; tone: "muted"; }
                        }
                        Text { text: d.ips; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        min-width: Scale.px(120px);
                        Text {
                            text: d.ping;
                            font-size: Scale.font-lg;
                            font-weight: 800;
                            color: d.tone == "success" ? Theme.success : d.tone == "warning" ? Theme.warning : d.tone == "danger" ? Theme.danger : Theme.text-muted;
                        }
                        Text { text: d.status; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
                    }
                    WbChip {
                        text: Tr.s("NetDiagSetDnsBtn");
                        enabled: !NetworkStore.busy;
                        clicked => { NetworkStore.apply-dns(d.primary, d.secondary, d.name); }
                    }
                }
            }
        }
    }
}

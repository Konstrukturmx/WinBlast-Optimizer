// ui/views/disk_health.slint
// WinBlast0 Disk Health, SMART Diagnostics & Authentic TBW in Slint 1.19

import { Scale, Theme } from "../theme.slint";
import { WbButton } from "../components/button.slint";
import { WbCard } from "../components/card.slint";
import { WbBadge } from "../components/badge.slint";
import { WbProgressBar } from "../components/progress_bar.slint";

export struct PhysicalDiskInfo {
    model: string,
    serial: string,
    bus-type: string,          // "NVMe" | "SATA"
    capacity-text: string,
    tbw-text: string,
    health-percent: int,
    temperature-c: int,
    power-on-hours: int,
    unsafe-shutdowns: int,
}

export component DiskHealthView inherits Flickable {
    in property <[PhysicalDiskInfo]> disks: [];

    callback refresh-disks();

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: Scale.space-lg;
        spacing: Scale.space-md;

        // Header Card
        WbCard {
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: Scale.space-2xs;
                    Text {
                        text: "Physical Storage & SMART Health Diagnostics";
                        font-size: Scale.font-xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "Authentic IOCTL_STORAGE_QUERY_PROPERTY and NVMe SMART protocol telemetry.";
                        font-size: Scale.font-sm;
                        color: Theme.text-secondary;
                    }
                }
                WbButton {
                    variant: "ghost";
                    text: "Refresh";
                    clicked => { root.refresh-disks(); }
                }
            }
        }

        // Disks List
        VerticalLayout {
            spacing: Scale.space-md;

            for disk in root.disks: WbCard {
                VerticalLayout {
                    spacing: Scale.space-md;

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: Scale.space-2xs;
                            HorizontalLayout {
                                spacing: Scale.space-sm;
                                Text {
                                    text: disk.model;
                                    font-size: Scale.font-lg;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                }
                                WbBadge {
                                    text: disk.bus-type;
                                    variant: disk.bus-type == "NVMe" ? "info" : "neutral";
                                }
                            }
                            Text {
                                text: "Serial: " + disk.serial + " — Capacity: " + disk.capacity-text;
                                font-size: Scale.font-xs;
                                color: Theme.text-muted;
                            }
                        }

                        HorizontalLayout {
                            spacing: Scale.space-md;
                            alignment: end;

                            VerticalLayout {
                                alignment: center;
                                Text { text: "HEALTH"; font-size: Scale.font-2xs; font-weight: 700; color: Theme.text-muted; }
                                Text {
                                    text: disk.health-percent + "%";
                                    font-size: Scale.font-xl;
                                    font-weight: 800;
                                    color: disk.health-percent >= 80 ? Theme.safe : (disk.health-percent >= 50 ? Theme.moderate : Theme.danger);
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text { text: "TEMP"; font-size: Scale.font-2xs; font-weight: 700; color: Theme.text-muted; }
                                Text {
                                    text: disk.temperature-c + " °C";
                                    font-size: Scale.font-xl;
                                    font-weight: 800;
                                    color: disk.temperature-c >= 60 ? Theme.high : Theme.safe;
                                }
                            }
                        }
                    }

                    // Metrics Grid
                    HorizontalLayout {
                        spacing: Scale.space-lg;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Scale.space-2xs;
                            Text { text: "Lifetime Data Written (TBW)"; font-size: Scale.font-xs; color: Theme.text-muted; }
                            Text { text: disk.tbw-text; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Scale.space-2xs;
                            Text { text: "Power-On Hours"; font-size: Scale.font-xs; color: Theme.text-muted; }
                            Text { text: disk.power-on-hours + " hrs"; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Scale.space-2xs;
                            Text { text: "Unsafe Shutdowns"; font-size: Scale.font-xs; color: Theme.text-muted; }
                            Text { text: disk.unsafe-shutdowns + " events"; font-size: Scale.font-sm; font-weight: 700; color: disk.unsafe-shutdowns > 50 ? Theme.moderate : Theme.text-primary; }
                        }
                    }
                }
            }
        }
    }
}

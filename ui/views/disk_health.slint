// ui/views/disk_health.slint
// Disk health & TRIM (port of v1.6.1): SMART health, lifetime writes, power-on hours, temps,
// non-blocking ReTrim of all fixed volumes.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { DiskStore } from "../stores/sensors.slint";
import { WbButton } from "../components/button.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";
import { WbProgressBar } from "../components/progress_bar.slint";

export component DiskHealthView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                cross-axis-alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: Scale.px(220px);
                    Text { text: Tr.s("DiskTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                    Text { text: Tr.s("DiskSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                }
                WbButton { variant: "secondary"; text: Tr.s("DiskRefreshBtn"); loading: DiskStore.scanning; enabled: !DiskStore.scanning; clicked => { DiskStore.refresh(); } }
                WbButton {
                    variant: "primary";
                    text: DiskStore.trim-inflight ? Tr.s("BusyWorking") : Tr.s("DiskTrimAllBtn");
                    enabled: !DiskStore.trim-inflight;
                    loading: DiskStore.trim-inflight;
                    clicked => { DiskStore.trim-all(); }
                }
            }

            Rectangle {
                border-radius: Scale.px(Theme.card-radius);
                background: DiskStore.trim-active ? Theme.success.with-alpha(0.12) : Theme.warning.with-alpha(0.12);
                border-width: 1px;
                border-color: DiskStore.trim-active ? Theme.success.with-alpha(0.4) : Theme.warning.with-alpha(0.4);
                min-height: Scale.px(36px);
                Text {
                    x: Scale.px(12px);
                    width: parent.width - Scale.px(24px);
                    text: DiskStore.trim-banner;
                    font-size: Scale.font-xs;
                    color: DiskStore.trim-active ? Theme.success : Theme.warning;
                    wrap: word-wrap;
                }
            }

            Text { text: Tr.s("DiskHealthStatus"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; }
            if DiskStore.drives.length == 0 : Text { text: DiskStore.scanning ? Tr.s("Scanning") : "—"; color: Theme.text-muted; }
            for d in DiskStore.drives : WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(6px);
                    HorizontalLayout {
                        spacing: Scale.px(8px);
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { text: d.title; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                            Text { text: d.sub; font-size: Scale.font-xs; color: Theme.text-muted; }
                        }
                        WbPill { text: d.status; tone: d.tone; y: (parent.height - self.height) / 2; }
                    }
                    HorizontalLayout {
                        spacing: Scale.px(8px);
                        Text { text: d.health-text; font-size: Scale.font-xs; color: Theme.text-secondary; }
                        WbProgressBar {
                            height: Scale.px(6px);
                            y: (parent.height - self.height) / 2;
                            horizontal-stretch: 1;
                            progress: d.health / 100;
                            bar-color: d.tone == "success" ? Theme.success : d.tone == "warning" ? Theme.warning : Theme.danger;
                        }
                    }
                    FlexboxLayout {
                        spacing: Scale.px(14px);
                        Text { text: d.writes; font-size: Scale.font-xs; color: Theme.text-secondary; }
                        Text { text: d.hours; font-size: Scale.font-xs; color: Theme.text-secondary; }
                        Text { text: d.temp; font-size: Scale.font-xs; color: Theme.text-secondary; }
                    }
                }
            }
        }
    }
}

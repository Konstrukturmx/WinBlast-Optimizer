// ui/views/game_prereqs.slint
// WinBlast0 Gaming Runtimes & Dependencies Installer in Slint 1.19

import { Scale, Theme } from "../theme.slint";
import { WbButton } from "../components/button.slint";
import { WbCard } from "../components/card.slint";
import { WbBadge } from "../components/badge.slint";

export struct PrereqItemData {
    id: string,
    name: string,
    description: string,
    installed-version: string,
    is-installed: bool,
    download-url: string,
}

export component GamePrereqsView inherits Flickable {
    in property <[PrereqItemData]> prereqs: [];
    in property <bool> is-installing-all: false;

    callback install-prereq(string);
    callback install-all-missing();
    callback refresh-prereqs();

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: Scale.space-lg;
        spacing: Scale.space-md;

        // Header Card
        WbCard {
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: Scale.space-2xs;
                    Text {
                        text: "Gaming Runtimes & Redistributables";
                        font-size: Scale.font-xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "Visual C++ runtimes (2005-2022), DirectX 9.0c End-User Runtimes, and .NET Desktop dependencies.";
                        font-size: Scale.font-sm;
                        color: Theme.text-secondary;
                    }
                }

                HorizontalLayout {
                    spacing: Scale.space-sm;
                    WbButton {
                        variant: "ghost";
                        text: "Refresh";
                        clicked => { root.refresh-prereqs(); }
                    }
                    WbButton {
                        variant: "primary";
                        text: "Install All Missing";
                        loading: root.is-installing-all;
                        clicked => { root.install-all-missing(); }
                    }
                }
            }
        }

        // Dependencies List
        VerticalLayout {
            spacing: Scale.space-xs;

            for item in root.prereqs: WbCard {
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: Scale.space-2xs;
                        HorizontalLayout {
                            spacing: Scale.space-sm;
                            Text {
                                text: item.name;
                                font-size: Scale.font-md;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }
                            WbBadge {
                                text: item.is-installed ? "Installed" : "Missing";
                                variant: item.is-installed ? "safe" : "moderate";
                                show-dot: item.is-installed;
                            }
                        }
                        Text {
                            text: item.description + (item.is-installed ? (" (" + item.installed-version + ")") : "");
                            font-size: Scale.font-xs;
                            color: Theme.text-secondary;
                        }
                    }

                    WbButton {
                        variant: item.is-installed ? "ghost" : "secondary";
                        text: item.is-installed ? "Reinstall" : "Install";
                        min-height: Scale.control-sm;
                        clicked => { root.install-prereq(item.id); }
                    }
                }
            }
        }
    }
}

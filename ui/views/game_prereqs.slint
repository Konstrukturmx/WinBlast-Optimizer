// ui/views/game_prereqs.slint
// Game runtime prerequisites (port of v1.6.1 game_prereqs): real detection, backend-routed installs.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { PrereqStore, PrereqRow } from "../stores/gaming.slint";
import { WbButton } from "../components/button.slint";
import { WbSearchInput } from "../components/search_input.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";
import { WbShimmer } from "../components/fx.slint";

component Count inherits WbPanel {
    in property <string> label;
    in property <int> value;
    in property <color> c: Theme.text-primary;
    min-width: Scale.px(150px);
    horizontal-stretch: 1;
    VerticalLayout {
        padding: Scale.px(12px);
        spacing: Scale.px(2px);
        Text { text: root.label; font-size: Scale.font-xs; color: root.c; wrap: word-wrap; }
        Text { text: root.value; font-size: Scale.font-xl; font-weight: 800; color: root.c; }
    }
}

export component GamePrereqsView inherits Rectangle {
    in property <int> tier;
    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            VerticalLayout {
                spacing: Scale.px(4px);
                Text { text: Tr.s("GamePrereqsTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                Text { text: Tr.s("GamePrereqsSub"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
            }
            FlexboxLayout {
                spacing: Scale.px(6px);
                WbButton {
                    variant: "primary";
                    text: PrereqStore.scanning ? Tr.s("Scanning") : Tr.s("GamePrereqsScan");
                    enabled: !PrereqStore.scanning && !PrereqStore.busy;
                    loading: PrereqStore.scanning;
                    clicked => { PrereqStore.scan(); }
                }
                WbButton {
                    variant: "secondary";
                    text: Tr.s("GamePrereqsInstallAll");
                    enabled: PrereqStore.missing > 0 && !PrereqStore.scanning && !PrereqStore.busy;
                    loading: PrereqStore.busy;
                    clicked => { PrereqStore.install-all(); }
                }
            }
            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                Count { label: Tr.s("GamePrereqsTotalTracked"); value: PrereqStore.total; }
                Count { label: Tr.s("GamePrereqsVerified"); value: PrereqStore.installed; c: Theme.success; }
                Count { label: Tr.s("GamePrereqsMissing"); value: PrereqStore.missing; c: PrereqStore.missing > 0 ? Theme.warning : Theme.text-secondary; }
            }
            WbSearchInput {
                placeholder: Tr.s("SearchPlaceholder");
                text: PrereqStore.filter;
                changed(t) => { PrereqStore.filter-edited(t); }
            }
            if PrereqStore.items.length == 0 && PrereqStore.scanning : WbPanel {
                VerticalLayout { padding: Scale.px(14px); WbShimmer { lines: 3; } }
            }
            if PrereqStore.items.length == 0 && !PrereqStore.scanning : WbPanel {
                height: Scale.px(72px);
                Text {
                    text: PrereqStore.total == 0 ? Tr.s("PrereqsEmpty") : Tr.s("PrereqsNoMatch");
                    font-size: Scale.font-sm;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            for i in PrereqStore.items : WbPanel {
                FlexboxLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(10px);
                    alignment: stretch;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        min-width: Scale.px(220px);
                        horizontal-stretch: 1;
                        spacing: Scale.px(2px);
                        Text { text: i.name; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                        Text { text: i.sub; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                        Text { text: i.version; font-size: Scale.font-2xs; color: Theme.text-secondary; wrap: word-wrap; }
                        if i.status != "" : Text { text: i.status; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
                    }
                    WbPill { text: i.state; tone: i.tone; }
                    WbButton {
                        variant: i.installed ? "secondary" : "primary";
                        text: i.busy ? Tr.s("PrereqStateInstalling") : i.installed ? Tr.s("PrereqReinstallBtn") : Tr.s("PrereqInstallBtn");
                        enabled: !PrereqStore.busy && !PrereqStore.scanning;
                        loading: i.busy;
                        clicked => { PrereqStore.install(i.id); }
                    }
                }
            }
        }
    }
}

// ui/views/cpu_parking.slint
// CPU Core Parking manager (port of v1.6.1): status, unpark/restore/refresh, stats, per-core cards.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { ParkingStore } from "../stores/sensors.slint";
import { WbButton } from "../components/button.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";
import { WbProgressBar } from "../components/progress_bar.slint";

component StatCell inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.text-primary;
    min-width: Scale.px(130px);
    horizontal-stretch: 1;
    Text { text: root.label; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
    Text { text: root.value; font-size: Scale.font-lg; font-weight: 800; color: root.tone; }
}

export component CpuParkingView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            WbPanel {
                FlexboxLayout {
                    padding: Scale.px(Theme.card-padding);
                    spacing: Scale.px(10px);
                    alignment: stretch;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: Scale.px(220px);
                        Text { text: Tr.s("CoreParkingTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                        Text { text: Tr.s("CoreParkingSub"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                    }
                    WbPill {
                        text: ParkingStore.fully-unparked ? Tr.s("CoreParkingStatusUnparked") : Tr.s("CoreParkingStatusParked");
                        tone: ParkingStore.fully-unparked ? "success" : "warning";
                    }
                }
            }

            FlexboxLayout {
                spacing: Scale.px(6px);
                WbButton {
                    variant: "primary";
                    text: ParkingStore.inflight ? Tr.s("BusyWorking") : Tr.s("UnparkAllCores");
                    enabled: !ParkingStore.inflight && !ParkingStore.rolling-back;
                    loading: ParkingStore.inflight;
                    clicked => { ParkingStore.unpark-all(); }
                }
                WbButton { variant: "secondary"; text: Tr.s("RestoreStockParking"); enabled: !ParkingStore.inflight && !ParkingStore.rolling-back; clicked => { ParkingStore.restore-stock(); } }
                WbButton { variant: "secondary"; text: Tr.s("RefreshCoresBtn"); clicked => { ParkingStore.refresh(); } }
            }

            WbPanel {
                FlexboxLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(14px);
                    alignment: stretch;
                    StatCell { label: Tr.s("TotalLogicalCores"); value: ParkingStore.total; }
                    StatCell { label: Tr.s("ActiveUnparked"); value: ParkingStore.unparked; tone: Theme.success; }
                    StatCell { label: Tr.s("ParkedSleeping"); value: ParkingStore.parked; tone: ParkingStore.parked > 0 ? Theme.warning : Theme.text-muted; }
                    StatCell { label: Tr.s("MinCoresAcDc"); value: ParkingStore.min-ac-dc; }
                }
            }

            FlexboxLayout {
                spacing: Scale.px(8px);
                alignment: stretch;
                for c in ParkingStore.cores : WbPanel {
                    min-width: root.tier == 0 ? Scale.px(170px) : Scale.px(210px);
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Scale.px(10px);
                        spacing: Scale.px(4px);
                        HorizontalLayout {
                            Text { text: c.title; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; horizontal-stretch: 1; }
                            Text { text: c.parked ? Tr.s("CoreStatusParked") : Tr.s("CoreStatusUnparked"); font-size: Scale.font-2xs; color: c.parked ? Theme.warning : Theme.success; }
                        }
                        Text { text: c.usage-text; font-size: Scale.font-xs; color: Theme.text-secondary; }
                        WbProgressBar { height: Scale.px(5px); progress: c.usage; bar-color: c.parked ? Theme.warning : Theme.success; }
                    }
                }
            }
        }
    }
}

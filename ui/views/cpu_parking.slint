// ui/views/cpu_parking.slint
// WinBlast0 CPU Core Parking & Frequency Scaling View in Slint 1.19

import { Scale, Theme } from "../theme.slint";
import { WbButton } from "../components/button.slint";
import { WbCard } from "../components/card.slint";
import { WbBadge } from "../components/badge.slint";
import { WbProgressBar } from "../components/progress_bar.slint";

export struct CoreStateItem {
    core-id: int,
    is-parked: bool,
    usage: float,
    frequency-mhz: int,
}

export component CpuParkingView inherits Flickable {
    in property <int> tier;
    in property <string> cpu-name: "AMD Ryzen 9 5900X 12-Core Processor";
    in property <int> logical-cores: 24;
    in property <int> physical-cores: 12;
    in property <int> parked-count: 0;

    in-out property <int> min-unparked-percent: 100; // 0 to 100%
    in-out property <string> active-power-scheme: "Ultimate Performance";

    in property <[CoreStateItem]> cores: [];

    callback apply-parking();
    callback set-power-scheme(string);
    callback reset-defaults();

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: Scale.space-lg;
        spacing: Scale.space-md;

        // Header Card
        WbCard {
            VerticalLayout {
                spacing: Scale.space-md;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: Scale.space-2xs;
                        Text {
                            text: "CPU Core Parking & Thread Scheduling";
                            font-size: Scale.font-xl;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: root.cpu-name + " (" + root.physical-cores + " Cores / " + root.logical-cores + " Threads)";
                            font-size: Scale.font-sm;
                            color: Theme.text-secondary;
                        }
                    }

                    HorizontalLayout {
                        spacing: Scale.space-sm;
                        alignment: end;
                        WbButton {
                            variant: "ghost";
                            text: "Defaults";
                            clicked => { root.reset-defaults(); }
                        }
                        WbButton {
                            variant: "primary";
                            text: "Apply 100% Unpark";
                            clicked => { root.apply-parking(); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Scale.space-sm;
                    WbBadge {
                        text: root.parked-count == 0 ? "All Cores Active (0 Parked)" : root.parked-count + " Cores Parked";
                        variant: root.parked-count == 0 ? "safe" : "moderate";
                        show-dot: true;
                    }
                    WbBadge {
                        text: "Scheme: " + root.active-power-scheme;
                        variant: "info";
                    }
                }
            }
        }

        // Core Parking Configuration Slider Card
        WbCard {
            VerticalLayout {
                spacing: Scale.space-md;

                Text {
                    text: "UNPARKED CORES THRESHOLD";
                    font-size: Scale.font-xs;
                    font-weight: 700;
                    color: Theme.text-muted;
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Minimum Unparked Core Percentage";
                        font-size: Scale.font-sm;
                        color: Theme.text-secondary;
                    }
                    Text {
                        text: root.min-unparked-percent + "%";
                        font-size: Scale.font-md;
                        font-weight: 700;
                        color: Theme.accent;
                    }
                }

                WbProgressBar {
                    progress: root.min-unparked-percent / 100.0;
                }

                Text {
                    text: "Setting to 100% disables Windows kernel core sleeping, keeping all execution units primed for instantaneous thread context switches.";
                    font-size: Scale.font-xs;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
        }

        // Power Scheme Selector Card
        WbCard {
            VerticalLayout {
                spacing: Scale.space-sm;

                Text {
                    text: "ACTIVE POWER PLAN";
                    font-size: Scale.font-xs;
                    font-weight: 700;
                    color: Theme.text-muted;
                }

                HorizontalLayout {
                    spacing: Scale.space-sm;

                    for scheme in ["Ultimate Performance", "High Performance", "Balanced"]: Rectangle {
                        private property <bool> is-active: root.active-power-scheme == scheme;
                        horizontal-stretch: 1;
                        height: Scale.control-md;
                        border-radius: Scale.radius-sm;
                        background: self.is-active ? Theme.accent : Theme.bg-surface;

                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: scheme;
                                font-size: Scale.font-xs;
                                font-weight: 600;
                                color: is-active ? Theme.text-on-accent : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.active-power-scheme = scheme;
                                root.set-power-scheme(scheme);
                            }
                        }
                    }
                }
            }
        }
    }
}

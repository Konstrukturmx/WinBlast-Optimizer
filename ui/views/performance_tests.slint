// ui/views/performance_tests.slint
// Performance benchmark suite (port of v1.6.1): composite score, CPU, RAM, disk.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { PerfStore } from "../stores/diagnostics.slint";
import { WbButton } from "../components/button.slint";
import { WbPanel } from "../components/toggle.slint";

component ScoreCard inherits WbPanel {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    min-width: Scale.px(220px);
    horizontal-stretch: 1;
    VerticalLayout {
        padding: Scale.px(12px);
        spacing: Scale.px(4px);
        Text { text: root.label; font-size: Scale.font-xs; color: Theme.text-secondary; }
        Text { text: root.value; font-size: Scale.font-xl; font-weight: 800; color: Theme.accent; }
        if root.sub != "" : Text { text: root.sub; font-size: Scale.font-2xs; color: Theme.text-muted; }
    }
}

export component PerformanceTestsView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            FlexboxLayout {
                spacing: Scale.px(8px);
                alignment: stretch;
                cross-axis-alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: Scale.px(220px);
                    Text { text: Tr.s("PerfTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                    Text { text: Tr.s("PerfSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                }
                WbButton {
                    variant: "primary";
                    text: PerfStore.running ? Tr.s("PerfBenchmarkingStatus") : Tr.s("PerfStartBtn");
                    enabled: !PerfStore.running;
                    loading: PerfStore.running;
                    clicked => { PerfStore.start(); }
                }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(16px);
                    spacing: Scale.px(4px);
                    Text { text: Tr.s("PerfCompositeScoreTitle"); font-size: Scale.font-sm; color: Theme.text-secondary; }
                    Text { text: PerfStore.composite; font-size: Scale.font-2xl; font-weight: 800; color: Theme.accent; }
                }
            }

            FlexboxLayout {
                spacing: Scale.px(12px);
                alignment: stretch;
                ScoreCard { label: Tr.s("PerfCpuLabel"); value: PerfStore.cpu-multi; sub: PerfStore.cpu-single; }
                ScoreCard { label: Tr.s("PerfRamLabel"); value: PerfStore.ram-read; sub: PerfStore.ram-latency; }
                ScoreCard { label: Tr.s("PerfDiskLabel"); value: PerfStore.disk-read; sub: Tr.s("StorageDrivesTitle"); }
            }
        }
    }
}

// ui/views/performance_tests.slint
// WinBlast0 Benchmark Performance Suites in Slint 1.19

import { Scale, Theme } from "../theme.slint";
import { WbButton } from "../components/button.slint";
import { WbCard } from "../components/card.slint";
import { WbBadge } from "../components/badge.slint";
import { WbProgressBar } from "../components/progress_bar.slint";

export component PerformanceTestsView inherits Flickable {
    in property <bool> is-running: false;
    in property <float> test-progress: 0.0;
    in property <int> cpu-single-score: 1680;
    in property <int> cpu-multi-score: 22450;
    in property <float> memory-bandwidth-gb: 54.2;
    in property <float> disk-seq-read-mb: 7120.0;

    callback run-all-benchmarks();

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: Scale.space-lg;
        spacing: Scale.space-md;

        // Header Card
        WbCard {
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: Scale.space-2xs;
                    Text {
                        text: "Hardware Performance Synthetic Benchmarks";
                        font-size: Scale.font-xl;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "Measure real computing throughput across CPU execution, memory bandwidth, and storage IOPS.";
                        font-size: Scale.font-sm;
                        color: Theme.text-secondary;
                    }
                }
                WbButton {
                    variant: "primary";
                    text: root.is-running ? "Benchmarking..." : "Run All Tests";
                    loading: root.is-running;
                    clicked => { root.run-all-benchmarks(); }
                }
            }
        }

        if root.is-running : WbCard {
            VerticalLayout {
                spacing: Scale.space-xs;
                Text { text: "Executing multi-threaded benchmark iterations..."; font-size: Scale.font-xs; color: Theme.accent; }
                WbProgressBar { progress: root.test-progress; }
            }
        }

        // Scores Grid
        HorizontalLayout {
            spacing: Scale.space-md;

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "CPU SINGLE-THREAD"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text { text: root.cpu-single-score + ""; font-size: Scale.font-2xl; font-weight: 800; color: Theme.accent; }
                    Text { text: "Integer & cryptographic throughput"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "CPU MULTI-THREAD"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text { text: root.cpu-multi-score + ""; font-size: Scale.font-2xl; font-weight: 800; color: Theme.safe; }
                    Text { text: "Full logical core parallel saturation"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "MEMORY BANDWIDTH"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text { text: round(root.memory-bandwidth-gb) + " GB/s"; font-size: Scale.font-2xl; font-weight: 800; color: Theme.info; }
                    Text { text: "DRAM sustained read rate"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }

            WbCard {
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-xs;
                    Text { text: "STORAGE SEQ READ"; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-muted; }
                    Text { text: round(root.disk-seq-read-mb) + " MB/s"; font-size: Scale.font-2xl; font-weight: 800; color: Theme.moderate; }
                    Text { text: "NVMe burst transfer speed"; font-size: Scale.font-xs; color: Theme.text-secondary; }
                }
            }
        }
    }
}

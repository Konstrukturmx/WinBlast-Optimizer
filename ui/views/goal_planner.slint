// ui/views/goal_planner.slint
// A* Goal Planner (port of v1.6.1): goal presets, solve + stage, metrics, Dijkstra schedule.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { PlannerStore } from "../stores/planner.slint";
import { WbButton } from "../components/button.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";

component GoalCard inherits WbPanel {
    in property <string> goal;
    in property <string> title-key;
    in property <string> desc-key;
    property <bool> active: PlannerStore.active-goal == root.goal;
    min-width: Scale.px(220px);
    horizontal-stretch: 1;
    border-color: active ? Theme.accent.with-alpha(0.5) : Theme.border;
    VerticalLayout {
        padding: Scale.px(12px);
        spacing: Scale.px(6px);
        Text { text: Tr.s(root.title-key); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
        Text { text: Tr.s(root.desc-key); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; vertical-stretch: 1; }
        WbButton {
            variant: root.active ? "primary" : "secondary";
            text: root.active ? Tr.s("GoalActiveBadge") : Tr.s("GoalSelectBtn");
            clicked => { PlannerStore.select-goal(root.goal); }
        }
    }
}

export component GoalPlannerView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            WbPanel {
                FlexboxLayout {
                    padding: Scale.px(Theme.card-padding);
                    spacing: Scale.px(8px);
                    alignment: stretch;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: Scale.px(220px);
                        Text { text: Tr.s("GoalPlannerTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                        Text { text: Tr.s("GoalPlannerSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                    }
                    WbButton { variant: "primary"; text: Tr.s("GoalSolveBtn"); clicked => { PlannerStore.solve(); } }
                    WbButton { variant: "secondary"; text: Tr.s("GoalStageBtn"); enabled: PlannerStore.has-plan; clicked => { PlannerStore.stage(); } }
                }
            }

            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                GoalCard { goal: "gaming"; title-key: "GoalPresetGamingTitle"; desc-key: "GoalPlannerPresetMaxFps"; }
                GoalCard { goal: "privacy"; title-key: "GoalPresetPrivacyTitle"; desc-key: "GoalPlannerPresetMaxPrivacy"; }
                GoalCard { goal: "balanced"; title-key: "GoalPresetBalancedTitle"; desc-key: "GoalPlannerPresetBalanced"; }
            }

            FlexboxLayout {
                spacing: Scale.px(8px);
                alignment: stretch;
                for m in PlannerStore.metrics : WbPanel {
                    min-width: Scale.px(150px);
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Scale.px(10px);
                        Text { text: m.label; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
                        Text {
                            text: m.value;
                            font-size: Scale.font-lg;
                            font-weight: 800;
                            color: m.tone == "danger" ? Theme.danger : m.tone == "success" ? Theme.success : m.tone == "warning" ? Theme.warning : m.tone == "accent" ? Theme.accent : Theme.text-primary;
                        }
                    }
                }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(6px);
                    Text { text: Tr.s("GoalPlannerScheduleTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; }
                    if PlannerStore.steps.length == 0 : Text { text: Tr.s("GoalPlannerSolvePrompt"); font-size: Scale.font-sm; color: Theme.text-muted; wrap: word-wrap; }
                    for st in PlannerStore.steps : Rectangle {
                        border-radius: Scale.px(Theme.btn-radius);
                        background: Theme.bg-primary;
                        HorizontalLayout {
                            padding: Scale.px(8px);
                            spacing: Scale.px(10px);
                            Text { text: st.index; font-size: Scale.font-xs; font-weight: 700; color: Theme.accent; vertical-alignment: center; width: Scale.px(32px); }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: st.title; font-size: Scale.font-sm; color: Theme.text-primary; wrap: word-wrap; }
                                Text { text: st.sub; font-size: Scale.font-2xs; color: Theme.text-muted; }
                            }
                            WbPill { text: st.badge; tone: st.tone; y: (parent.height - self.height) / 2; }
                        }
                    }
                }
            }
        }
    }
}

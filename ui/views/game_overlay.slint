// ui/views/game_overlay.slint
// Game Bar / background DVR / Game Mode (port of v1.6.1 game_overlay). The switches show the real
// registry state read by the backend and change it through the backend.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { GamingStore } from "../stores/gaming.slint";
import { WbToggle, WbPill, WbPanel } from "../components/toggle.slint";

component OverlayRow inherits WbPanel {
    in property <string> title;
    in property <string> desc;
    in property <bool> on;
    callback clicked();
    FlexboxLayout {
        padding: Scale.px(12px);
        spacing: Scale.px(12px);
        alignment: stretch;
        cross-axis-alignment: center;
        VerticalLayout {
            min-width: Scale.px(200px);
            horizontal-stretch: 1;
            spacing: Scale.px(2px);
            Text { text: root.title; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
            Text { text: root.desc; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
        }
        WbPill { text: root.on ? "✔ " + Tr.s("OverlayActiveState") : Tr.s("OverlayDisabledState"); tone: root.on ? "success" : "muted"; }
        WbToggle {
            on: root.on;
            busy: GamingStore.overlay-busy;
            enabled: !GamingStore.overlay-busy;
            accessible-name: root.title;
            clicked => { root.clicked(); }
        }
    }
}

export component GameOverlayBody inherits VerticalLayout {
    in property <int> tier;
    spacing: Scale.px(10px);
    alignment: start;

    VerticalLayout {
        spacing: Scale.px(4px);
        Text { text: Tr.s("OverlayTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
        Text { text: Tr.s("OverlaySubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
    }
    OverlayRow {
        title: Tr.s("OverlayDisableGameBar");
        desc: Tr.s("OverlayDisableGameBarDesc");
        on: GamingStore.game-bar-disabled;
        clicked => { GamingStore.set-overlay("gamebar", !GamingStore.game-bar-disabled); }
    }
    OverlayRow {
        title: Tr.s("OverlayDisableDvr");
        desc: Tr.s("OverlayDisableDvrDesc");
        on: GamingStore.dvr-disabled;
        clicked => { GamingStore.set-overlay("dvr", !GamingStore.dvr-disabled); }
    }
    OverlayRow {
        title: Tr.s("OverlayGameMode");
        desc: Tr.s("OverlayGameModeDesc");
        on: GamingStore.game-mode;
        clicked => { GamingStore.set-overlay("gamemode", !GamingStore.game-mode); }
    }
}

export component GameOverlayView inherits Rectangle {
    in property <int> tier;
    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            alignment: start;
            GameOverlayBody { tier: root.tier; }
        }
    }
}

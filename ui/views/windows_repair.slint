// ui/views/windows_repair.slint
// Windows component repair suite (port of v1.6.1): SFC, DISM, Winsock, WU reset… now run on
// a worker thread with a live log (v1.6.1 froze the window while they ran).
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr, Typo } from "../theme.slint";
import { RepairStore } from "../stores/diagnostics.slint";
import { WbButton } from "../components/button.slint";
import { WbChip } from "../components/chip.slint";
import { WbPanel } from "../components/toggle.slint";

export component WindowsRepairView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            FlexboxLayout {
                spacing: Scale.px(8px);
                alignment: stretch;
                cross-axis-alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: Scale.px(220px);
                    Text { text: Tr.s("RepairTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                    Text { text: Tr.s("RepairSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                }
                WbButton {
                    variant: "primary";
                    text: RepairStore.running == "all" ? Tr.s("BusyWorking") : Tr.s("RepairRunAllBtn");
                    enabled: RepairStore.running == "";
                    loading: RepairStore.running == "all";
                    clicked => { RepairStore.run("all"); }
                }
            }

            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                for t in RepairStore.tasks : WbPanel {
                    min-width: Scale.px(260px);
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Scale.px(12px);
                        spacing: Scale.px(6px);
                        HorizontalLayout {
                            spacing: Scale.px(8px);
                            Text { text: t.icon; font-size: Scale.font-lg; }
                            Text { text: t.title; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                        }
                        Text { text: t.command; font-size: Scale.font-2xs; color: Theme.accent; wrap: word-wrap; }
                        Text { text: t.desc; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; vertical-stretch: 1; }
                        WbButton {
                            variant: "primary";
                            text: RepairStore.running == t.id ? Tr.s("BusyWorking") : Tr.s("RepairRunBtn");
                            enabled: RepairStore.running == "";
                            loading: RepairStore.running == t.id;
                            clicked => { RepairStore.run(t.id); }
                        }
                    }
                }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(6px);
                    HorizontalLayout {
                        Text { text: Tr.s("RepairConsoleTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; horizontal-stretch: 1; }
                        if RepairStore.log.length > 0 : WbChip { text: Tr.s("ChangelogClear"); clicked => { RepairStore.clear-log(); } }
                    }
                    Rectangle {
                        border-radius: Scale.px(Theme.btn-radius);
                        background: #0b0d12;
                        min-height: Scale.px(90px);
                        VerticalLayout {
                            padding: Scale.px(10px);
                            spacing: Scale.px(2px);
                            alignment: start;
                            if RepairStore.log.length == 0 : Text { text: Tr.s("RepairReadyStatus"); font-family: Typo.mono; font-size: Scale.font-xs; color: #8fbf8f; }
                            for l in RepairStore.log : Text { text: l; font-family: Typo.mono; font-size: Scale.font-xs; color: #d6e2d6; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }
}

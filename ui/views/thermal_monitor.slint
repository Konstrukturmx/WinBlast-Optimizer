// ui/views/thermal_monitor.slint
// Thermal & fan monitor (port of v1.6.1) with honest "no sensors" fallback.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { ThermalStore } from "../stores/sensors.slint";
import { WbButton } from "../components/button.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";

component Gauge inherits WbPanel {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <string> tone;
    min-width: Scale.px(220px);
    horizontal-stretch: 1;
    VerticalLayout {
        padding: Scale.px(12px);
        spacing: Scale.px(4px);
        HorizontalLayout {
            spacing: Scale.px(6px);
            Text { text: root.icon; }
            Text { text: root.label; font-size: Scale.font-xs; color: Theme.text-secondary; }
        }
        Text {
            text: root.value;
            font-size: Scale.font-2xl;
            font-weight: 800;
            color: root.tone == "danger" ? Theme.danger : root.tone == "warning" ? Theme.warning : root.tone == "success" ? Theme.success : Theme.text-muted;
        }
        if root.detail != "" : Text { text: root.detail; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
    }
}

export component ThermalMonitorView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                cross-axis-alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: Scale.px(220px);
                    Text { text: Tr.s("ThermalTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                    Text { text: Tr.s("ThermalSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                }
                WbButton {
                    variant: "primary";
                    text: Tr.s("ThermalRefreshBtn");
                    loading: ThermalStore.scanning;
                    enabled: !ThermalStore.scanning;
                    clicked => { ThermalStore.refresh(); }
                }
            }

            Rectangle {
                border-radius: Scale.px(Theme.card-radius);
                background: ThermalStore.sensors-available ? Theme.success.with-alpha(0.12) : Theme.warning.with-alpha(0.12);
                border-width: 1px;
                border-color: ThermalStore.sensors-available ? Theme.success.with-alpha(0.4) : Theme.warning.with-alpha(0.4);
                min-height: Scale.px(40px);
                Text {
                    x: Scale.px(12px);
                    width: parent.width - Scale.px(24px);
                    text: ThermalStore.sensors-available ? Tr.s("ThermalActiveSensors") : Tr.s("ThermalOemBanner");
                    font-size: Scale.font-xs;
                    color: ThermalStore.sensors-available ? Theme.success : Theme.warning;
                    wrap: word-wrap;
                }
            }

            FlexboxLayout {
                spacing: Scale.px(12px);
                alignment: stretch;
                Gauge { icon: "❄"; label: Tr.s("ThermalCpuPackage"); value: ThermalStore.cpu-temp; detail: ThermalStore.cpu-detail; tone: ThermalStore.cpu-tone; }
                Gauge { icon: "🎮"; label: Tr.s("ThermalGpuCore"); value: ThermalStore.gpu-temp; detail: ThermalStore.gpu-detail; tone: ThermalStore.gpu-tone; }
                Gauge { icon: "💨"; label: Tr.s("ThermalFanRpm"); value: ThermalStore.fan-text; detail: ThermalStore.fan-detail; tone: "muted"; }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(6px);
                    Text { text: Tr.s("ThermalComponentsTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; }
                    if ThermalStore.components.length == 0 : Text { text: "—"; color: Theme.text-muted; }
                    for c in ThermalStore.components : Rectangle {
                        border-radius: Scale.px(Theme.btn-radius);
                        background: Theme.bg-primary;
                        HorizontalLayout {
                            padding: Scale.px(8px);
                            spacing: Scale.px(10px);
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: c.name; font-size: Scale.font-sm; color: Theme.text-primary; }
                                Text { text: "Thermal Threshold: " + c.threshold; font-size: Scale.font-2xs; color: Theme.text-muted; }
                            }
                            Text { text: c.temp; font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                            WbPill { text: c.status; tone: c.tone; y: (parent.height - self.height) / 2; }
                        }
                    }
                }
            }
        }
    }
}

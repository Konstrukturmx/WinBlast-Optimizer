// ui/views/easy_dashboard.slint
// Easy Mode Dashboard (port of v1.6.1): admin banner, self-updater, health ring + scan,
// live CPU/RAM waveforms, category breakdown, before/after impact, hardware summary,
// 1-click presets and quick-launch cards.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr, Typo } from "../theme.slint";
import { AppStore } from "../stores/app.slint";
import { MatrixStore } from "../stores/matrix.slint";
import { DashboardStore } from "../stores/dashboard.slint";
import { WbButton } from "../components/button.slint";
import { WbPanel } from "../components/toggle.slint";
import { WbSparkline } from "../components/sparkline.slint";
import { WbProgressBar } from "../components/progress_bar.slint";
import { WbGauge } from "../components/fx.slint";

component CardTitle inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    spacing: Scale.px(6px);
    Text { text: root.icon; font-size: Scale.font-sm; vertical-alignment: center; }
    Text { text: root.text; font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
}

component Metric inherits VerticalLayout {
    in property <string> label;
    in property <string> now;
    in property <string> was;
    in property <string> delta;
    in property <color> delta-color;
    spacing: Scale.px(2px);
    min-width: Scale.px(150px);
    Text { text: root.label; font-size: Scale.font-xs; color: Theme.text-muted; }
    HorizontalLayout {
        spacing: Scale.px(6px);
        Text { text: root.now; font-family: Typo.mono; font-size: Scale.font-lg; font-weight: 700; color: Theme.text-primary; }
        Text { text: root.was; font-size: Scale.font-xs; color: Theme.text-muted; vertical-alignment: center; }
    }
    Text { text: root.delta; font-size: Scale.font-xs; color: root.delta-color; wrap: word-wrap; }
}

component QuickCard inherits WbPanel {
    in property <string> title-key;
    in property <string> desc-key;
    in property <string> btn-key;
    in property <string> view;
    in property <bool> accent;
    min-width: Scale.px(200px);
    VerticalLayout {
        padding: Scale.px(12px);
        spacing: Scale.px(6px);
        Text { text: Tr.s(root.title-key); font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
        Text { text: Tr.s(root.desc-key); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; vertical-stretch: 1; }
        WbButton { variant: root.accent ? "primary" : "secondary"; text: Tr.s(root.btn-key); clicked => { AppStore.navigate(root.view); } }
    }
}

component HwCell inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    spacing: Scale.px(2px);
    min-width: Scale.px(180px);
    Text { text: root.label; font-size: Scale.font-xs; color: Theme.accent; }
    Text { text: root.value; font-size: Scale.font-md; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
    if root.sub != "" : Text { text: root.sub; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
}

export component EasyDashboardView inherits Rectangle {
    in property <int> tier;
    private property <color> health-color: DashboardStore.health-tone == "success" ? Theme.success : DashboardStore.health-tone == "warning" ? Theme.warning : Theme.danger;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            // ---- Administrator warning ----
            if DashboardStore.admin-required : Rectangle {
                border-radius: Scale.px(Theme.card-radius);
                background: Theme.warning.with-alpha(0.14);
                border-width: 1px;
                border-color: Theme.warning.with-alpha(0.55);
                FlexboxLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(10px);
                    cross-axis-alignment: center;
                    Text { text: "⚠️"; font-size: Scale.font-lg; }
                    VerticalLayout {
                        min-width: Scale.px(220px);
                        Text { text: Tr.s("AdminRequiredTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.warning; wrap: word-wrap; }
                        Text { text: Tr.s("AdminRequiredDesc"); font-size: Scale.font-xs; color: Theme.text-secondary; wrap: word-wrap; }
                    }
                    WbButton { variant: "secondary"; text: Tr.s("RelaunchAdminBtn"); clicked => { DashboardStore.relaunch-admin(); } }
                }
            }

            // ---- Self-updater ----
            WbPanel {
                FlexboxLayout {
                    padding: Scale.px(10px);
                    spacing: Scale.px(10px);
                    cross-axis-alignment: center;
                    Text {
                        text: DashboardStore.update-state == "available" ? "🚀" : DashboardStore.update-state == "downloading" ? "📥"
                            : DashboardStore.update-state == "checking" ? "↻" : DashboardStore.update-state == "failed" ? "⚠"
                            : DashboardStore.update-state == "idle" ? "📦" : "✓";
                        font-size: Scale.font-md;
                        color: DashboardStore.update-state == "failed" ? Theme.danger : Theme.accent;
                    }
                    VerticalLayout {
                        min-width: Scale.px(200px);
                        Text { text: DashboardStore.update-title; font-size: Scale.font-sm; font-weight: 600; color: DashboardStore.update-state == "failed" ? Theme.danger : Theme.text-primary; wrap: word-wrap; }
                        if DashboardStore.update-detail != "" : Text { text: DashboardStore.update-detail; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                        if DashboardStore.update-state == "downloading" : WbProgressBar { height: Scale.px(6px); progress: DashboardStore.update-progress; }
                    }
                    if DashboardStore.update-state == "idle" || DashboardStore.update-state == "uptodate" || DashboardStore.update-state == "failed" : WbButton {
                        variant: "secondary"; text: Tr.s("UpdateCheckBtn"); clicked => { DashboardStore.check-updates(); }
                    }
                    if DashboardStore.update-state == "available" : WbButton {
                        variant: "primary"; text: Tr.s("UpdateDownloadInstallBtn"); clicked => { DashboardStore.download-update(); }
                    }
                    if DashboardStore.update-state == "ready" : WbButton {
                        variant: "primary"; text: Tr.s("UpdateReadyRestartBtn"); clicked => { DashboardStore.apply-restart(); }
                    }
                }
            }

            // ---- Header: title + health ring + scan ----
            WbPanel {
                glow: true;
                FlexboxLayout {
                    padding: Scale.px(Theme.card-padding);
                    spacing: Scale.px(14px);
                    cross-axis-alignment: center;
                    VerticalLayout {
                        min-width: Scale.px(220px);
                        spacing: Scale.px(4px);
                        Text { text: Tr.s("NavSystemPanel"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                        Text { text: Tr.s("DashboardSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                    }
                    HorizontalLayout {
                        spacing: Scale.px(10px);
                        WbGauge {
                            width: Scale.px(72px);
                            value: DashboardStore.health-score;
                            tone: root.health-color;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: Tr.s("SystemHealth"); font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; }
                            Text { text: Tr.s("OptimizedLabel"); font-size: Scale.font-xs; color: Theme.text-muted; }
                        }
                    }
                    WbButton {
                        variant: "primary";
                        text: DashboardStore.is-scanning ? Tr.s("Scanning") : Tr.s("ScanSystem");
                        enabled: !DashboardStore.is-scanning;
                        loading: DashboardStore.is-scanning;
                        clicked => { AppStore.start-scan(); }
                    }
                }
            }

            // ---- Live telemetry ----
            if DashboardStore.metrics-available : FlexboxLayout {
                spacing: Scale.px(12px);
                WbPanel {
                    min-width: root.tier == 0 ? Scale.px(240px) : Scale.px(300px);
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Scale.px(12px);
                        spacing: Scale.px(6px);
                        HorizontalLayout {
                            spacing: Scale.px(12px);
                            WbGauge { width: Scale.px(64px); value: AppStore.cpu-usage; available: AppStore.metrics-available; tone: Theme.sparkline-cpu; }
                            VerticalLayout {
                                alignment: center;
                                spacing: Scale.px(2px);
                                Text { text: DashboardStore.cpu-title; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                                Text { text: DashboardStore.cpu-text; font-family: Typo.mono; font-size: Scale.font-xs; color: Theme.sparkline-cpu; wrap: word-wrap; }
                            }
                        }
                        WbSparkline { values: DashboardStore.cpu-points; stroke-color: Theme.sparkline-cpu; max-val: 100; }
                    }
                }
                WbPanel {
                    min-width: root.tier == 0 ? Scale.px(240px) : Scale.px(300px);
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Scale.px(12px);
                        spacing: Scale.px(6px);
                        HorizontalLayout {
                            spacing: Scale.px(12px);
                            WbGauge { width: Scale.px(64px); value: AppStore.ram-usage; available: AppStore.metrics-available; tone: Theme.sparkline-ram; }
                            VerticalLayout {
                                alignment: center;
                                spacing: Scale.px(2px);
                                Text { text: DashboardStore.ram-title; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                                Text { text: DashboardStore.ram-text; font-family: Typo.mono; font-size: Scale.font-xs; color: Theme.sparkline-ram; wrap: word-wrap; }
                            }
                        }
                        WbSparkline { values: DashboardStore.ram-points; stroke-color: Theme.sparkline-ram; max-val: 100; }
                    }
                }
            }

            // ---- Category breakdown ----
            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(10px);
                    CardTitle { icon: "📊"; text: Tr.s("DashboardCatBreakdownTitle"); }
                    FlexboxLayout {
                        spacing: Scale.px(14px);
                        for c in DashboardStore.categories : VerticalLayout {
                            min-width: Scale.px(140px);
                            horizontal-stretch: 1;
                            spacing: Scale.px(4px);
                            HorizontalLayout {
                                Text { text: c.label; font-size: Scale.font-xs; color: Theme.text-secondary; horizontal-stretch: 1; overflow: elide; }
                                Text { text: c.optimized + "/" + c.total; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-primary; }
                            }
                            WbProgressBar {
                                height: Scale.px(6px);
                                progress: c.total > 0 ? c.optimized / c.total : 0;
                                bar-color: c.tone == "accent" ? Theme.accent : c.tone == "success" ? Theme.success : c.tone == "warning" ? Theme.warning : Theme.text-secondary;
                            }
                        }
                    }
                }
            }

            // ---- Before / after impact ----
            if DashboardStore.impact-available : WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(10px);
                    FlexboxLayout {
                        spacing: Scale.px(10px);
                        cross-axis-alignment: center;
                        VerticalLayout {
                            min-width: Scale.px(220px);
                            Text { text: Tr.s("BeforeAfterImpact"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; }
                            Text { text: Tr.s("BeforeAfterSub"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                        }
                        WbButton {
                            variant: "secondary";
                            text: DashboardStore.baseline-reset-inflight ? Tr.s("BusyWorking") : Tr.s("ResetBaseline");
                            enabled: !DashboardStore.baseline-reset-inflight;
                            clicked => { DashboardStore.reset-baseline(); }
                        }
                    }
                    FlexboxLayout {
                        spacing: Scale.px(16px);
                        Metric { label: Tr.s("RamUsage"); now: DashboardStore.ram-now; was: DashboardStore.ram-was; delta: DashboardStore.ram-delta; delta-color: DashboardStore.ram-good ? Theme.success : Theme.warning; }
                        Metric { label: Tr.s("BackgroundProcesses"); now: DashboardStore.proc-now; was: DashboardStore.proc-was; delta: DashboardStore.proc-delta; delta-color: DashboardStore.proc-good ? Theme.success : Theme.warning; }
                        Metric { label: Tr.s("TimerResolution"); now: DashboardStore.timer-now; was: ""; delta: DashboardStore.timer-was; delta-color: DashboardStore.timer-good ? Theme.success : Theme.text-secondary; }
                        Metric { label: Tr.s("ActiveOptimizations"); now: DashboardStore.opt-now; was: DashboardStore.opt-was; delta: DashboardStore.opt-delta; delta-color: DashboardStore.opt-gained ? Theme.success : Theme.text-muted; }
                    }
                }
            }

            // ---- Hardware summary ----
            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(10px);
                    CardTitle { icon: "💻"; text: Tr.s("DashboardHwSummaryTitle"); }
                    FlexboxLayout {
                        spacing: Scale.px(16px);
                        HwCell { label: Tr.s("DashboardHwCpu"); value: DashboardStore.hw-cpu; sub: DashboardStore.hw-cpu-topology; }
                        HwCell { label: Tr.s("DashboardHwGpu"); value: DashboardStore.hw-gpu; sub: DashboardStore.hw-gpu-detail; }
                        HwCell { label: Tr.s("DashboardHwRam"); value: DashboardStore.hw-ram; sub: DashboardStore.hw-board; }
                        HwCell { label: Tr.s("DashboardHwPlatform"); value: DashboardStore.hw-uptime; sub: DashboardStore.hw-rules; }
                    }
                }
            }

            // ---- Quick actions ----
            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(10px);
                    FlexboxLayout {
                        spacing: Scale.px(8px);
                        cross-axis-alignment: center;
                        CardTitle { icon: "⚡"; text: Tr.s("QuickActionsTitle"); min-width: Scale.px(180px); }
                        WbButton { variant: "primary"; text: Tr.s("GamingPreset"); clicked => { MatrixStore.apply-preset("gaming"); } }
                        WbButton { variant: "secondary"; text: Tr.s("ProAudioPreset"); clicked => { MatrixStore.apply-preset("pro_audio"); } }
                        WbButton { variant: "secondary"; text: Tr.s("LaptopBatteryPreset"); clicked => { MatrixStore.apply-preset("laptop_battery"); } }
                    }
                    FlexboxLayout {
                        spacing: Scale.px(10px);
                        QuickCard { title-key: "DashboardQaFpsTitle"; desc-key: "DashboardQaFpsDesc"; btn-key: "DashboardQaFpsBtn"; view: "matrix"; accent: true; }
                        QuickCard { title-key: "DashboardQaCleanTitle"; desc-key: "DashboardQaCleanDesc"; btn-key: "DashboardQaCleanBtn"; view: "clean_apps"; }
                        QuickCard { title-key: "DashboardQaCpuTitle"; desc-key: "DashboardQaCpuDesc"; btn-key: "DashboardQaCpuBtn"; view: "cpu_parking"; }
                        QuickCard { title-key: "DashboardQaDriverTitle"; desc-key: "DashboardQaDriverDesc"; btn-key: "DashboardQaDriverBtn"; view: "driver_bios"; }
                        QuickCard { title-key: "DashboardQaFaultTitle"; desc-key: "DashboardQaFaultDesc"; btn-key: "DashboardQaFaultBtn"; view: "fault_diagnostics"; }
                    }
                }
            }
        }
    }
}

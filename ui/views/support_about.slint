// ui/views/support_about.slint
// Support & About (port of v1.6.1 support_about): version, repository links, bug report,
// 1.7.0 release highlights and the live UI style studio.
import { ScrollView, AboutSlint } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { AppStore } from "../stores/app.slint";
import { AboutStore } from "../stores/about.slint";
import { WbButton } from "../components/button.slint";
import { WbPill, WbPanel } from "../components/toggle.slint";

component Note inherits Text {
    font-size: Scale.font-xs;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

export component SupportAboutView inherits Rectangle {
    in property <int> tier;
    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            VerticalLayout {
                spacing: Scale.px(4px);
                Text { text: Tr.s("AboutTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                Text { text: Tr.s("PrereqVersionLabel") + " " + AppStore.app-version + " • " + Tr.s("AboutTagline"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(8px);
                    FlexboxLayout {
                        spacing: Scale.px(10px);
                        alignment: stretch;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            min-width: Scale.px(220px);
                            horizontal-stretch: 1;
                            spacing: Scale.px(2px);
                            Text { text: Tr.s("AboutRepoLabel"); font-size: Scale.font-xs; color: Theme.text-secondary; wrap: word-wrap; }
                            Text { text: AboutStore.repo-name; font-size: Scale.font-lg; font-weight: 800; color: Theme.accent; wrap: word-wrap; }
                            Text { text: AboutStore.repo-url; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                        }
                        WbButton { variant: "primary"; text: Tr.s("AboutOpenGithub"); clicked => { AboutStore.open-github(); } }
                        WbButton { variant: "danger"; text: Tr.s("FaultReportToGithub"); clicked => { AppStore.open-bug-report(); } }
                    }
                    Note { text: Tr.s("AboutBuiltWith"); }
                }
            }

            // Slint Royalty-Free Desktop licence: attribution must be shown in the application.
            WbPanel {
                HorizontalLayout {
                    padding: Scale.px(12px);
                    alignment: start;
                    AboutSlint { max-height: Scale.px(140px); }
                }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(6px);
                    Text { text: Tr.s("AboutWhatsNewTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                    Note { text: Tr.s("AboutNew1"); }
                    Note { text: Tr.s("AboutNew2"); }
                    Note { text: Tr.s("AboutNew3"); }
                    Note { text: Tr.s("AboutNew4"); }
                    Note { text: Tr.s("AboutNew5"); }
                    Note { text: Tr.s("AboutNew6"); }
                }
            }

            WbPanel {
                VerticalLayout {
                    padding: Scale.px(12px);
                    spacing: Scale.px(8px);
                    Text { text: Tr.s("AboutStudioTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                    Note { text: Tr.s("AboutStudioSubtitle"); }
                    FlexboxLayout {
                        spacing: Scale.px(8px);
                        alignment: stretch;
                        for st[i] in AppStore.theme-styles : Rectangle {
                            min-width: Scale.px(170px);
                            horizontal-stretch: 1;
                            border-radius: Scale.px(Theme.card-radius);
                            background: st.selected ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.bg-card-hover : Theme.bg-card;
                            border-width: Theme.border-width;
                            border-color: st.selected ? Theme.accent : Theme.border;
                            ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppStore.set-theme-style(i); }
                            }
                            VerticalLayout {
                                padding: Scale.px(10px);
                                spacing: Scale.px(4px);
                                HorizontalLayout {
                                    spacing: Scale.px(6px);
                                    Text { text: st.label; font-size: Scale.font-sm; font-weight: 700; color: st.selected ? Theme.accent : Theme.text-primary; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    if st.selected : WbPill { text: Tr.s("AboutActiveBadge"); tone: "accent"; }
                                }
                                if st.detail != "" : Text { text: st.detail; font-size: Scale.font-2xs; color: Theme.text-muted; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }
    }
}

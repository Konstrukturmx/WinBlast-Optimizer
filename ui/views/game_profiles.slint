// ui/views/game_profiles.slint
// Per-game optimization profiles (port of v1.6.1 game_profiles), applied/reverted via the backend.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { GamingStore, ProfileRow } from "../stores/gaming.slint";
import { WbButton } from "../components/button.slint";
import { WbPanel } from "../components/toggle.slint";

component Bullet inherits Text {
    font-size: Scale.font-xs;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

export component GameProfilesBody inherits VerticalLayout {
    in property <int> tier;
    spacing: Scale.px(10px);
    alignment: start;

    VerticalLayout {
        spacing: Scale.px(4px);
        Text { text: Tr.s("GameProfilesTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
        Text { text: Tr.s("GameProfilesSubtitle"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
    }
    if GamingStore.profiles.length == 0 : WbPanel {
        VerticalLayout {
            padding: Scale.px(16px);
            spacing: Scale.px(4px);
            Text { text: "🎮"; font-size: Scale.font-lg; horizontal-alignment: center; }
            Text { text: Tr.s("GameProfilesEmptyTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center; wrap: word-wrap; }
            Text { text: Tr.s("GameProfilesEmptyDesc"); font-size: Scale.font-xs; color: Theme.text-muted; horizontal-alignment: center; wrap: word-wrap; }
        }
    }
    for p in GamingStore.profiles : WbPanel {
        border-color: p.applied ? Theme.success : Theme.border;
        VerticalLayout {
            padding: Scale.px(12px);
            spacing: Scale.px(6px);
            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                cross-axis-alignment: center;
                Text { text: p.icon; font-size: Scale.font-lg; }
                VerticalLayout {
                    min-width: Scale.px(180px);
                    horizontal-stretch: 1;
                    Text { text: p.title; font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                    Text { text: p.target; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                }
                WbButton {
                    variant: p.applied ? "secondary" : "primary";
                    text: p.applied ? Tr.s("GameProfilesActiveBtn") : Tr.s("GameProfilesApplyBtn");
                    enabled: !GamingStore.profile-busy;
                    loading: p.busy;
                    clicked => { GamingStore.toggle-profile(p.id); }
                }
            }
            Text { text: p.desc; font-size: Scale.font-xs; color: Theme.text-secondary; wrap: word-wrap; }
            if p.high-priority : Bullet { text: Tr.s("GameProfileHighPriority"); }
            if p.disable-fso : Bullet { text: Tr.s("GameProfileDisableFso"); }
            if p.unpark : Bullet { text: Tr.s("GameProfileUnparkCores"); }
        }
    }
}

export component GameProfilesView inherits Rectangle {
    in property <int> tier;
    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            alignment: start;
            GameProfilesBody { tier: root.tier; }
        }
    }
}

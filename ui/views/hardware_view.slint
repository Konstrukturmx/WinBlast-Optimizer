// ui/views/hardware_view.slint
// Hardware overview (port of v1.6.1): live waveforms, CPU topology + per-core load, NT latency,
// power plans / hibernation / USB power, platform security, DIMMs, storage, GPU shortcut.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { AppStore } from "../stores/app.slint";
import { HardwareStore } from "../stores/hardware.slint";
import { WbChip } from "../components/chip.slint";
import { WbButton } from "../components/button.slint";
import { WbPanel } from "../components/toggle.slint";
import { WbSparkline } from "../components/sparkline.slint";
import { WbProgressBar } from "../components/progress_bar.slint";
import { WbKvList, WbTitledList, WbSection } from "../components/kv.slint";

export component HardwareViewComponent inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                cross-axis-alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: Scale.px(220px);
                    Text { text: Tr.s("HardwareTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                    Text { text: Tr.s("HardwareSub"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                }
                WbButton { variant: "secondary"; text: Tr.s("RefreshHardwareBtn"); clicked => { HardwareStore.refresh(); } }
            }

            if !HardwareStore.metrics-available : WbSection { title: Tr.s("CpuSparklineTitle"); Text { text: Tr.s("Scanning"); font-size: Scale.font-sm; color: Theme.text-muted; } }
            if HardwareStore.metrics-available : FlexboxLayout {
                spacing: Scale.px(12px);
                alignment: stretch;
                WbSection {
                    min-width: root.tier == 0 ? Scale.px(240px) : Scale.px(300px);
                    horizontal-stretch: 1;
                    title: HardwareStore.cpu-title;
                    Text { text: HardwareStore.cpu-text; font-size: Scale.font-xs; color: Theme.sparkline-cpu; }
                    WbSparkline { values: HardwareStore.cpu-points; stroke-color: Theme.sparkline-cpu; }
                }
                WbSection {
                    min-width: root.tier == 0 ? Scale.px(240px) : Scale.px(300px);
                    horizontal-stretch: 1;
                    title: HardwareStore.ram-title;
                    Text { text: HardwareStore.ram-text; font-size: Scale.font-xs; color: Theme.sparkline-ram; }
                    WbSparkline { values: HardwareStore.ram-points; stroke-color: Theme.sparkline-ram; }
                }
            }

            WbSection {
                title: Tr.s("CpuCardTitle");
                WbKvList { rows: HardwareStore.cpu-rows; }
                if HardwareStore.cores.length > 0 : Text { text: Tr.s("LiveCores"); font-size: Scale.font-xs; font-weight: 700; color: Theme.text-secondary; }
                if HardwareStore.cores.length > 0 : FlexboxLayout {
                    spacing: Scale.px(6px);
                    for c in HardwareStore.cores : VerticalLayout {
                        width: Scale.px(76px);
                        spacing: Scale.px(2px);
                        Text { text: c.label; font-size: Scale.font-2xs; color: Theme.text-secondary; }
                        WbProgressBar {
                            height: Scale.px(5px);
                            progress: c.value;
                            bar-color: c.tone == "danger" ? Theme.danger : c.tone == "warning" ? Theme.warning : Theme.accent;
                        }
                    }
                }
            }

            WbSection {
                title: Tr.s("LatencyCardTitle");
                WbKvList { rows: HardwareStore.latency-rows; }
                if HardwareStore.latency-snapshot-title != "" : Rectangle { height: 1px; background: Theme.border; }
                if HardwareStore.latency-snapshot-title != "" : Text { text: HardwareStore.latency-snapshot-title; font-size: Scale.font-xs; font-weight: 700; color: Theme.text-secondary; }
                WbKvList { rows: HardwareStore.latency-snapshot-rows; }
                HorizontalLayout { alignment: start; WbButton { variant: "secondary"; text: Tr.s("RefreshLatencyBtn"); clicked => { HardwareStore.refresh-latency(); } } }
            }

            WbSection {
                title: Tr.s("PowerMgrTitle");
                if HardwareStore.schemes.length == 0 : Text { text: Tr.s("Scanning"); font-size: Scale.font-sm; color: Theme.text-muted; }
                FlexboxLayout {
                    spacing: Scale.px(6px);
                    for p in HardwareStore.schemes : WbChip {
                        text: p.label;
                        active: p.active;
                        enabled: !HardwareStore.power-inflight && !HardwareStore.rolling-back;
                        clicked => { HardwareStore.set-power-plan(p.id); }
                    }
                }
                Rectangle { height: 1px; background: Theme.border.with-alpha(0.5); }
                FlexboxLayout {
                    spacing: Scale.px(8px);
                    Text { text: Tr.s("HibernationLabel"); font-size: Scale.font-xs; color: Theme.text-muted; min-width: Scale.px(150px); }
                    Text { text: HardwareStore.hibernation-note; font-size: Scale.font-xs; color: Theme.text-primary; wrap: word-wrap; }
                }
                FlexboxLayout {
                    spacing: Scale.px(6px);
                    WbButton {
                        variant: "primary";
                        text: HardwareStore.power-inflight ? Tr.s("BusyWorking") : Tr.s("UltimatePowerPlanBtn");
                        enabled: !HardwareStore.power-inflight && !HardwareStore.rolling-back;
                        clicked => { HardwareStore.ultimate-plan(); }
                    }
                    WbButton {
                        variant: "secondary";
                        text: HardwareStore.hibernation-inflight ? Tr.s("BusyWorking")
                            : Tr.s("HibernationLabel") + ": " + (HardwareStore.hibernation-enabled ? Tr.s("ToggleDisable") : Tr.s("ToggleEnable"));
                        enabled: !HardwareStore.hibernation-inflight && !HardwareStore.rolling-back;
                        clicked => { HardwareStore.toggle-hibernation(!HardwareStore.hibernation-enabled); }
                    }
                    WbButton {
                        variant: "secondary";
                        text: HardwareStore.usb-inflight ? Tr.s("BusyWorking") : Tr.s("UsbPowerLabel") + " (" + Tr.s("ToggleDisable") + ")";
                        enabled: !HardwareStore.usb-inflight && !HardwareStore.rolling-back;
                        clicked => { HardwareStore.usb-power-saving(true); }
                    }
                    WbButton {
                        variant: "secondary";
                        text: HardwareStore.usb-inflight ? Tr.s("BusyWorking") : Tr.s("UsbPowerLabel") + " (" + Tr.s("ToggleEnable") + ")";
                        enabled: !HardwareStore.usb-inflight && !HardwareStore.rolling-back;
                        clicked => { HardwareStore.usb-power-saving(false); }
                    }
                }
            }

            WbSection { title: Tr.s("PlatformSecurityTitle"); WbKvList { rows: HardwareStore.security-rows; } }

            WbSection {
                title: Tr.s("MemoryDimmsTitle");
                if HardwareStore.dimm-fallback != "" : Text { text: HardwareStore.dimm-fallback; font-size: Scale.font-sm; color: Theme.text-secondary; wrap: word-wrap; }
                WbTitledList { rows: HardwareStore.dimms; }
            }

            WbSection {
                title: Tr.s("StorageDrivesTitle");
                if HardwareStore.volumes.length == 0 : Text { text: Tr.s("Scanning"); font-size: Scale.font-sm; color: Theme.text-muted; }
                WbTitledList { rows: HardwareStore.volumes; }
            }

            WbSection {
                title: Tr.s("GpuCardTitle");
                Text { text: Tr.s("GpuTuningSub"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                HorizontalLayout { alignment: start; WbButton { variant: "primary"; text: Tr.s("GpuTuning"); clicked => { AppStore.navigate("gpu"); } } }
            }
        }
    }
}

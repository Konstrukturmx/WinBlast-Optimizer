// ui/views/gpu_tuning.slint
// WinBlast0 GPU Tuning & Graphics Optimization View in Slint 1.19

import { Scale, Theme } from "../theme.slint";
import { WbButton } from "../components/button.slint";
import { WbCard } from "../components/card.slint";
import { WbBadge } from "../components/badge.slint";
import { WbSwitch } from "../components/switch.slint";
import { WbProgressBar } from "../components/progress_bar.slint";

export component GpuTuningView inherits Flickable {
    in property <string> gpu-name: "NVIDIA GeForce RTX 4080 (16GB)";
    in property <string> driver-version: "566.14 (WHQL)";
    in property <bool> is-msi-enabled: true;
    in property <bool> is-rebar-supported: true;
    in property <bool> is-hags-enabled: true;

    in-out property <int> core-clock-offset: 0;   // MHz
    in-out property <int> memory-clock-offset: 0; // MHz
    in-out property <int> power-limit: 100;       // %
    in-out property <int> fan-speed: 55;          // %

    callback apply-tuning();
    callback reset-defaults();
    callback msi-toggled(bool);
    callback hags-toggled(bool);

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: Scale.space-lg;
        spacing: Scale.space-md;

        // GPU Identification & Hardware Features
        WbCard {
            VerticalLayout {
                spacing: Scale.space-md;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: Scale.space-2xs;
                        Text {
                            text: "GPU Performance & Interrupt Tuning";
                            font-size: Scale.font-xl;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: root.gpu-name + " — Driver: " + root.driver-version;
                            font-size: Scale.font-sm;
                            color: Theme.text-secondary;
                        }
                    }

                    HorizontalLayout {
                        spacing: Scale.space-sm;
                        alignment: end;
                        WbButton {
                            variant: "ghost";
                            text: "Reset Defaults";
                            clicked => { root.reset-defaults(); }
                        }
                        WbButton {
                            variant: "primary";
                            text: "Apply Settings";
                            clicked => { root.apply-tuning(); }
                        }
                    }
                }

                // Feature Status Badges
                HorizontalLayout {
                    spacing: Scale.space-sm;
                    WbBadge {
                        text: root.is-msi-enabled ? "MSI Interrupts Active" : "Legacy Pin Interrupts";
                        variant: root.is-msi-enabled ? "safe" : "moderate";
                        show-dot: true;
                    }
                    WbBadge {
                        text: root.is-rebar-supported ? "Resizable BAR Active" : "ReBAR Disabled";
                        variant: root.is-rebar-supported ? "safe" : "neutral";
                        show-dot: true;
                    }
                    WbBadge {
                        text: root.is-hags-enabled ? "HAGS Enabled" : "HAGS Disabled";
                        variant: root.is-hags-enabled ? "info" : "neutral";
                    }
                }
            }
        }

        // Interrupt Optimization Card
        WbCard {
            VerticalLayout {
                spacing: Scale.space-md;
                Text {
                    text: "INTERRUPT & KERNEL SCHEDULING";
                    font-size: Scale.font-xs;
                    font-weight: 700;
                    color: Theme.text-muted;
                }

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: Scale.space-2xs;
                        Text {
                            text: "Message Signaled Interrupts (MSI Mode)";
                            font-size: Scale.font-md;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Routes GPU interrupt requests directly over PCIe bus, eliminating line sharing latency.";
                            font-size: Scale.font-xs;
                            color: Theme.text-secondary;
                        }
                    }
                    WbSwitch {
                        checked: root.is-msi-enabled;
                        toggled(c) => { root.msi-toggled(c); }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: Scale.space-2xs;
                        Text {
                            text: "Hardware Accelerated GPU Scheduling (HAGS)";
                            font-size: Scale.font-md;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Delegates high-frequency frame scheduling to the dedicated GPU scheduling processor.";
                            font-size: Scale.font-xs;
                            color: Theme.text-secondary;
                        }
                    }
                    WbSwitch {
                        checked: root.is-hags-enabled;
                        toggled(c) => { root.hags-toggled(c); }
                    }
                }
            }
        }

        // Clock & Power Sliders
        WbCard {
            VerticalLayout {
                spacing: Scale.space-md;

                Text {
                    text: "CLOCK FREQUENCY & POWER TARGETS";
                    font-size: Scale.font-xs;
                    font-weight: 700;
                    color: Theme.text-muted;
                }

                // Core Clock
                VerticalLayout {
                    spacing: Scale.space-2xs;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "GPU Core Clock Offset"; font-size: Scale.font-sm; color: Theme.text-secondary; }
                        Text { text: (root.core-clock-offset >= 0 ? "+" : "") + root.core-clock-offset + " MHz"; font-size: Scale.font-sm; font-weight: 700; color: Theme.accent; }
                    }
                    WbProgressBar { progress: clamp((root.core-clock-offset + 200) / 400.0, 0.0, 1.0); }
                }

                // Memory Clock
                VerticalLayout {
                    spacing: Scale.space-2xs;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Video Memory Clock Offset"; font-size: Scale.font-sm; color: Theme.text-secondary; }
                        Text { text: (root.memory-clock-offset >= 0 ? "+" : "") + root.memory-clock-offset + " MHz"; font-size: Scale.font-sm; font-weight: 700; color: Theme.accent; }
                    }
                    WbProgressBar { progress: clamp((root.memory-clock-offset + 500) / 1000.0, 0.0, 1.0); }
                }

                // Power Limit
                VerticalLayout {
                    spacing: Scale.space-2xs;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Power Limit Target"; font-size: Scale.font-sm; color: Theme.text-secondary; }
                        Text { text: root.power-limit + "%"; font-size: Scale.font-sm; font-weight: 700; color: Theme.accent; }
                    }
                    WbProgressBar { progress: clamp(root.power-limit / 120.0, 0.0, 1.0); }
                }
            }
        }
    }
}

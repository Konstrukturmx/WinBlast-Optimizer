// ui/views/gpu_tuning.slint
// GPU Tuning (port of v1.6.1): detected adapters, display engine (HAGS / MPO), per-adapter
// PCIe MSI mode + interrupt priority, and vendor-gated silicon tweak cards.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { GpuStore } from "../stores/gpu.slint";
import { MatrixStore } from "../stores/matrix.slint";
import { WbChip } from "../components/chip.slint";
import { WbButton } from "../components/button.slint";
import { WbToggle, WbRiskBadge, WbPill, WbPanel } from "../components/toggle.slint";

component Section inherits WbPanel {
    in property <string> title;
    VerticalLayout {
        padding: Scale.px(12px);
        spacing: Scale.px(8px);
        Text { text: root.title; font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
        @children
    }
}

component Kv inherits HorizontalLayout {
    in property <string> k;
    in property <string> v;
    spacing: Scale.px(8px);
    Text { text: root.k; font-size: Scale.font-xs; color: Theme.text-muted; width: Scale.px(130px); }
    Text { text: root.v; font-size: Scale.font-xs; color: Theme.text-primary; wrap: word-wrap; horizontal-stretch: 1; }
}

export component GpuTuningView inherits Rectangle {
    in property <int> tier;

    ScrollView {
        VerticalLayout {
            padding: root.tier == 0 ? Scale.px(10px) : Scale.px(14px);
            spacing: Scale.px(12px);
            alignment: start;

            VerticalLayout {
                spacing: Scale.px(4px);
                Text { text: Tr.s("GpuTuningTitle"); font-size: Scale.font-xl; font-weight: 800; color: Theme.text-primary; wrap: word-wrap; }
                Text { text: Tr.s("GpuTuningSub"); font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
            }

            Section {
                title: Tr.s("DetectedGpuHeader");
                if GpuStore.adapters.length == 0 : Text { text: Tr.s("NoGpuDetected"); font-size: Scale.font-sm; color: Theme.text-muted; }
                for g in GpuStore.adapters : HorizontalLayout {
                    spacing: Scale.px(8px);
                    Text { text: "🟢"; vertical-alignment: center; }
                    Text { text: "#" + g.index + " " + g.name; font-size: Scale.font-sm; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    WbPill {
                        text: g.vendor + " (✓)";
                        tone: g.vendor == "NVIDIA" ? "accent" : g.vendor == "AMD" ? "danger" : g.vendor == "Intel" ? "success" : "muted";
                    }
                }
            }

            Section {
                title: Tr.s("DisplayEngineTitle");
                FlexboxLayout {
                    spacing: Scale.px(10px);
                    alignment: stretch;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: Scale.px(220px);
                        Text { text: Tr.s("HagsTitle"); font-size: Scale.font-sm; font-weight: 600; color: Theme.text-primary; }
                        Text {
                            text: !GpuStore.hags-supported ? Tr.s("HagsUnsupportedNote") : GpuStore.hags-enabled ? Tr.s("HagsActiveStatus") : Tr.s("HagsDisabledStatus");
                            font-size: Scale.font-xs;
                            color: !GpuStore.hags-supported ? Theme.text-muted : GpuStore.hags-enabled ? Theme.success : Theme.warning;
                            wrap: word-wrap;
                        }
                    }
                    WbButton {
                        variant: GpuStore.hags-enabled ? "secondary" : "primary";
                        text: !GpuStore.hags-supported ? Tr.s("StatusNotApplicable")
                            : GpuStore.hags-inflight ? Tr.s("BusyWorking")
                            : GpuStore.hags-enabled ? Tr.s("DisableHags") : Tr.s("EnableHags");
                        enabled: GpuStore.hags-supported && !GpuStore.hags-inflight && !GpuStore.rolling-back;
                        clicked => { GpuStore.toggle-hags(!GpuStore.hags-enabled); }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                FlexboxLayout {
                    spacing: Scale.px(10px);
                    alignment: stretch;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: Scale.px(220px);
                        Text { text: Tr.s("MpoTitle"); font-size: Scale.font-sm; font-weight: 600; color: Theme.text-primary; }
                        Text { text: GpuStore.mpo-disabled ? Tr.s("MpoFixedStatus") : Tr.s("MpoEnabledStatus"); font-size: Scale.font-xs; color: GpuStore.mpo-disabled ? Theme.success : Theme.text-muted; wrap: word-wrap; }
                    }
                    WbButton {
                        variant: GpuStore.mpo-disabled ? "secondary" : "primary";
                        text: GpuStore.mpo-inflight ? Tr.s("BusyWorking") : GpuStore.mpo-disabled ? Tr.s("RestoreMpoDefault") : Tr.s("DisableMpoFix");
                        enabled: !GpuStore.mpo-inflight && !GpuStore.rolling-back;
                        clicked => { GpuStore.toggle-mpo(!GpuStore.mpo-disabled); }
                    }
                }
            }

            Section {
                title: Tr.s("PcieMsiTitle");
                if GpuStore.adapters.length == 0 : Text { text: Tr.s("NoPcieGpuDetected"); font-size: Scale.font-sm; color: Theme.text-muted; }
                for g in GpuStore.adapters : Rectangle {
                    border-radius: Scale.px(Theme.btn-radius);
                    background: Theme.bg-primary;
                    VerticalLayout {
                        padding: Scale.px(10px);
                        spacing: Scale.px(6px);
                        Text { text: Tr.s("PcieAdapterPrefix") + " #" + g.index + ": " + g.name; font-size: Scale.font-sm; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
                        Kv { k: Tr.s("AdapterName"); v: g.name; }
                        Kv { k: Tr.s("DevicePnpId"); v: g.pnp; }
                        FlexboxLayout {
                            spacing: Scale.px(8px);
                            cross-axis-alignment: center;
                            Text { text: g.msi ? Tr.s("MsiEnabledStatus") : Tr.s("MsiDisabledStatus"); font-size: Scale.font-xs; color: g.msi ? Theme.success : Theme.warning; }
                            WbButton {
                                variant: g.msi ? "secondary" : "primary";
                                text: g.busy ? Tr.s("BusyWorking") : !g.pnp-valid ? Tr.s("StatusNotApplicable") : g.msi ? Tr.s("SwitchToLineIrq") : Tr.s("EnableMsiMode");
                                enabled: g.pnp-valid && !g.busy && !GpuStore.rolling-back;
                                clicked => { GpuStore.set-msi(g.pnp, !g.msi, g.priority); }
                            }
                        }
                        FlexboxLayout {
                            spacing: Scale.px(6px);
                            cross-axis-alignment: center;
                            Text {
                                text: Tr.s("InterruptPriority") + ": " + (g.priority == 1 ? Tr.s("PriorityLow") : g.priority == 3 ? Tr.s("PriorityHigh") : Tr.s("PriorityNormal"));
                                font-size: Scale.font-xs;
                                color: Theme.text-secondary;
                            }
                            for p[i] in [1, 2, 3] : WbChip {
                                text: p == 1 ? Tr.s("PriorityLow") : p == 2 ? Tr.s("PriorityNormal") : Tr.s("PriorityHigh");
                                active: g.priority == p;
                                enabled: g.pnp-valid && !g.busy && !GpuStore.rolling-back;
                                clicked => { GpuStore.set-msi(g.pnp, g.msi, p); }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Scale.px(8px);
                Text { text: Tr.s("VendorSiliconTitle"); font-size: Scale.font-md; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                if GpuStore.hidden-count > 0 : WbChip { text: Tr.s("UnhideAll") + " (" + GpuStore.hidden-count + ")"; tone: "accent"; clicked => { GpuStore.unhide-all(); } }
            }
            FlexboxLayout {
                spacing: Scale.px(10px);
                alignment: stretch;
                for t in GpuStore.tweaks : Rectangle {
                    min-width: root.tier == 0 ? Scale.px(240px) : Scale.px(300px);
                    horizontal-stretch: 1;
                    border-radius: Scale.px(Theme.card-radius);
                    background: t.supported ? Theme.bg-card : Theme.warning.with-alpha(0.08);
                    border-width: 1px;
                    border-color: t.supported ? (t.active ? Theme.accent.with-alpha(0.35) : Theme.border) : Theme.warning.with-alpha(0.32);
                    VerticalLayout {
                        padding: Scale.px(12px);
                        spacing: Scale.px(6px);
                        if !t.supported : HorizontalLayout {
                            spacing: Scale.px(6px);
                            Text { text: "⚠"; color: Theme.warning; }
                            Text { text: Tr.s("NotSupportedOnSystem"); font-size: Scale.font-xs; font-weight: 700; color: Theme.warning; }
                        }
                        Text { text: t.title; font-size: Scale.font-sm; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                        FlexboxLayout {
                            spacing: Scale.px(6px);
                            WbPill { text: "🖵 " + t.vendor; tone: "accent"; }
                            WbPill { text: "⚡ " + t.sub-category; tone: "muted"; }
                        }
                        if t.supported : Text { text: t.desc; font-size: Scale.font-xs; color: Theme.text-muted; wrap: word-wrap; }
                        if !t.supported : Text { text: Tr.s("ConditionFailed") + " " + t.required; font-size: Scale.font-xs; color: Theme.warning; wrap: word-wrap; }
                        FlexboxLayout {
                            spacing: Scale.px(6px);
                            cross-axis-alignment: center;
                            if t.supported : WbRiskBadge { level: t.risk-level; label: t.risk-label; }
                            if t.supported : Text { text: t.state-text; font-size: Scale.font-xs; color: t.active ? Theme.success : Theme.text-muted; }
                            if t.supported && t.not-applicable : WbPill { text: Tr.s("StatusNotApplicable"); }
                            if t.supported && !t.not-applicable : WbToggle { on: t.active; busy: t.in-flight; accessible-name: t.title; clicked => { MatrixStore.switch-clicked(t.id); } }
                            WbChip { text: t.supported ? "< / >" : "ⓘ " + Tr.s("WhatIsThis"); clicked => { MatrixStore.inspect(t.id); } }
                            WbChip { text: t.supported ? "👁" : Tr.s("Hide"); clicked => { GpuStore.hide-tweak(t.id); } }
                        }
                    }
                }
            }
        }
    }
}

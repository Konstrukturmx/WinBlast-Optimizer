// ui/shell/statusbar.slint
// Bottom chrome (port of v1.6.1): optimization progress strip with changelog toggle,
// expandable localized transaction changelog with per-entry Undo, and footer status line.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { AppStore, ChangelogEntry } from "../stores/app.slint";
import { WbChip } from "../components/chip.slint";
import { WbProgressBar } from "../components/progress_bar.slint";

export component AppProgressStrip inherits Rectangle {
    height: Scale.px(28px);
    background: Theme.bg-sidebar;
    HorizontalLayout {
        padding-left: Scale.px(12px);
        padding-right: Scale.px(12px);
        padding-top: Scale.px(3px);
        padding-bottom: Scale.px(3px);
        spacing: Scale.px(10px);
        Text {
            text: AppStore.progress-text;
            font-size: Scale.font-xs;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0;
            horizontal-stretch: 1;
        }
        // F5: the bar only shows while something is in progress (it was an empty strip at idle).
        if AppStore.progress-value > 0 : WbProgressBar {
            horizontal-stretch: 2;
            height: Scale.px(7px);
            y: (parent.height - self.height) / 2;
            progress: AppStore.progress-value;
            bar-color: AppStore.progress-tone == "warning" ? Theme.warning
                : AppStore.progress-tone == "success" ? Theme.success : Theme.accent;
        }
        WbChip {
            text: AppStore.show-changelog ? Tr.s("ChangelogToggleHide") : Tr.s("ChangelogToggleShow");
            active: AppStore.show-changelog;
            clicked => { AppStore.toggle-changelog(); }
        }
    }
}

component ChangelogRow inherits Rectangle {
    in property <ChangelogEntry> entry;
    border-radius: Scale.px(Theme.badge-radius);
    background: Theme.bg-card;
    min-height: Scale.px(30px);
    HorizontalLayout {
        padding-left: Scale.px(8px);
        padding-right: Scale.px(8px);
        padding-top: Scale.px(4px);
        padding-bottom: Scale.px(4px);
        spacing: Scale.px(8px);
        Text { text: entry.timestamp; font-size: Scale.font-2xs; color: Theme.text-muted; vertical-alignment: center; }
        Rectangle {
            border-radius: Scale.px(Theme.badge-radius);
            background: Theme.accent.with-alpha(0.15);
            HorizontalLayout {
                padding-left: Scale.px(5px);
                padding-right: Scale.px(5px);
                Text { text: entry.action; font-size: Scale.font-2xs; color: Theme.accent; vertical-alignment: center; }
            }
        }
        Text {
            text: entry.title;
            font-size: Scale.font-xs;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0;
        }
        badge := Rectangle {
            property <color> tone: entry.rolled-back ? Theme.text-muted : !entry.reversible ? Theme.warning : Theme.success;
            border-radius: Scale.px(Theme.badge-radius);
            background: tone.with-alpha(0.16);
            HorizontalLayout {
                padding-left: Scale.px(5px);
                padding-right: Scale.px(5px);
                Text {
                    text: entry.rolled-back ? Tr.s("RolledBackBadge") : !entry.reversible ? Tr.s("NonReversibleBadge") : Tr.s("AppliedBadge");
                    font-size: Scale.font-2xs;
                    color: badge.tone;
                    vertical-alignment: center;
                }
            }
        }
        if !entry.rolled-back && entry.reversible : WbChip {
            tone: "warning";
            enabled: AppStore.can-undo;
            text: AppStore.is-rolling-back ? Tr.s("BusyWorking") : Tr.s("UndoBtn");
            clicked => { if !AppStore.is-rolling-back { AppStore.rollback(entry.id); } }
        }
    }
}

export component AppChangelog inherits Rectangle {
    in property <int> tier;
    height: tier == 0 ? Scale.px(110px) : Scale.px(150px);
    background: Theme.bg-primary;
    Rectangle { height: Theme.border-width; y: 0; background: Theme.border; }
    VerticalLayout {
        padding-left: Scale.px(12px);
        padding-right: Scale.px(12px);
        padding-top: Scale.px(6px);
        spacing: Scale.px(4px);
        HorizontalLayout {
            spacing: Scale.px(8px);
            Text {
                text: Tr.s("ChangelogTitle");
                font-size: Scale.font-sm;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            WbChip { text: Tr.s("ChangelogClear"); tone: "danger"; clicked => { AppStore.clear-changelog(); } }
        }
        if AppStore.changelog.length == 0 : Text {
            text: Tr.s("ChangelogEmpty");
            font-size: Scale.font-xs;
            color: Theme.text-muted;
        }
        if AppStore.changelog.length > 0 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Scale.px(4px);
                padding-bottom: Scale.px(6px);
                alignment: start;
                for e in AppStore.changelog : ChangelogRow { entry: e; }
            }
        }
    }
}

export component AppFooter inherits Rectangle {
    in property <int> tier;
    height: Scale.px(26px);
    background: Theme.bg-sidebar;
    Rectangle { height: Theme.border-width; y: 0; background: Theme.border; }
    HorizontalLayout {
        padding-left: Scale.px(12px);
        padding-right: Scale.px(8px);
        spacing: Scale.px(10px);
        Text {
            text: AppStore.status-message;
            font-size: Scale.font-xs;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0;
        }
        if root.tier != 0 : Text {
            text: Tr.s("FooterStatus");
            font-size: Scale.font-2xs;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        report := TouchArea {
            width: report-text.preferred-width + Scale.px(12px);
            mouse-cursor: pointer;
            clicked => { AppStore.open-bug-report(); }
            report-text := Text {
                text: Tr.s("FooterReportBug");
                font-size: Scale.font-xs;
                color: report.has-hover ? Theme.accent-hover : Theme.accent;
                vertical-alignment: center;
            }
        }
    }
}

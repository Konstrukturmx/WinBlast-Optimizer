// ui/shell/sidebar.slint
import { Scale, Theme } from "../theme.slint";

export struct NavItemData {
    id: string,
    label: string,
    badge-count: int,
    icon-path: string,
}

component SidebarSectionHeader inherits Rectangle {
    in property <string> title: "";
    in property <bool> collapsed: false;

    height: root.collapsed ? Scale.px(12px) : Scale.px(26px);
    background: transparent;

    if !root.collapsed : Text {
        x: Scale.space-md;
        width: max(0px, parent.width - Scale.space-lg);
        height: 100%;
        text: root.title;
        color: Theme.text-muted;
        font-size: Scale.font-2xs;
        font-weight: 700;
        letter-spacing: 0.9px;
        vertical-alignment: bottom;
        overflow: elide;
    }

    if root.collapsed : Rectangle {
        x: Scale.space-sm;
        y: parent.height / 2;
        width: max(0px, parent.width - Scale.space-md);
        height: 1px;
        background: Theme.border-subtle;
    }
}

component SidebarNavItem inherits Rectangle {
    in property <string> label: "";
    in property <string> icon-path: "";
    in property <int> badge-count: 0;
    in property <bool> active: false;
    in property <bool> collapsed: false;

    callback clicked();

    height: Scale.px(34px);
    border-radius: Scale.radius-sm;
    background: root.active ? Theme.accent-subtle : transparent;

    accessible-role: button;
    accessible-label: root.label;

    animate background {
        duration: 150ms;
        easing: spring(0.1);
    }

    // Active left pill indicator
    if root.active : Rectangle {
        x: 0px;
        y: Scale.px(7px);
        width: Scale.px(3px);
        height: parent.height - Scale.px(14px);
        border-radius: Scale.radius-pill;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : Scale.space-md;
        padding-right: root.collapsed ? 0px : Scale.space-sm;
        spacing: Scale.space-sm;
        alignment: root.collapsed ? center : stretch;

        Rectangle {
            width: Scale.px(18px);
            background: transparent;

            Path {
                width: Scale.px(15px);
                height: Scale.px(15px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon-path;
                stroke: root.active ? Theme.accent : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
                stroke-width: 1.8px;
                fill: transparent;
            }
        }

        if !root.collapsed : Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.active ? Theme.text-primary : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
            font-size: Scale.font-md;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
        }

        if !root.collapsed && root.badge-count > 0 : Rectangle {
            min-width: Scale.px(20px);
            height: Scale.px(18px);
            y: (parent.height - self.height) / 2;
            border-radius: Scale.radius-pill;
            background: root.active ? Theme.accent : Theme.bg-surface-active;

            Text {
                width: 100%;
                height: 100%;
                text: root.badge-count;
                color: root.active ? Theme.text-on-accent : Theme.text-secondary;
                font-size: Scale.font-2xs;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    states [
        hover when ta.has-hover && !root.active : {
            root.background: Theme.bg-surface-hover;
        }
        pressed when ta.pressed && !root.active : {
            root.background: Theme.bg-surface-active;
        }
    ]
}

export component AppSidebar inherits Rectangle {
    in-out property <string> active-view: "dashboard";
    in-out property <bool> collapsed: false;
    in-out property <length> expanded-width: Scale.px(236px);

    // Optional live badge counts per view
    in property <int> pending-tweaks-count: 0;
    in property <int> startup-items-count: 0;

    callback navigate(string);

    private property <length> min-drawer-width: Scale.px(180px);
    private property <length> max-drawer-width: Scale.px(340px);
    private property <length> default-drawer-width: Scale.px(236px);
    private property <length> collapsed-width: Scale.px(56px);

    // Structured view catalogs grouped by the five required sections
    private property <[NavItemData]> optimization-items: [
        { id: "dashboard",   label: "Overview",          badge-count: 0,                        icon-path: "M 3 13 L 10 13 L 10 3 L 3 3 Z M 14 21 L 21 21 L 21 11 L 14 11 Z M 14 3 L 21 3 L 21 7 L 14 7 Z M 3 17 L 10 17 L 10 21 L 3 21 Z" },
        { id: "tweaks",      label: "System Tweaks",     badge-count: root.pending-tweaks-count, icon-path: "M 4 7 L 20 7 M 4 17 L 20 17 M 9 4 L 9 10 M 15 14 L 15 20" },
        { id: "privacy",     label: "Privacy & Telemetry", badge-count: 0,                      icon-path: "M 12 3 L 20 6 L 20 12 C 20 17 16 20 12 21 C 8 20 4 17 4 12 L 4 6 Z" },
        { id: "services",    label: "Services & Startup", badge-count: root.startup-items-count, icon-path: "M 13 2 L 4 14 L 12 14 L 11 22 L 20 10 L 12 10 Z" },
    ];

    private property <[NavItemData]> diagnostics-items: [
        { id: "telemetry",   label: "Live Monitor",      badge-count: 0, icon-path: "M 3 12 L 7 12 L 10 5 L 14 19 L 17 12 L 21 12" },
        { id: "hardware",    label: "Hardware Info",     badge-count: 0, icon-path: "M 7 7 L 17 7 L 17 17 L 7 17 Z M 9 3 L 9 7 M 15 3 L 15 7 M 9 17 L 9 21 M 15 17 L 15 21 M 3 9 L 7 9 M 3 15 L 7 15 M 17 9 L 21 9 M 17 15 L 21 15" },
        { id: "latency",     label: "DPC Latency",       badge-count: 0, icon-path: "M 12 4 A 8 8 0 1 0 20 12 M 12 12 L 17 7" },
    ];

    private property <[NavItemData]> gaming-items: [
        { id: "game-mode",   label: "Game Booster",      badge-count: 0, icon-path: "M 6 9 L 18 9 C 20 9 21 11 21 13 L 20 17 C 19.5 18.5 18 19 16.5 18 L 14.5 16 L 9.5 16 L 7.5 18 C 6 19 4.5 18.5 4 17 L 3 13 C 3 11 4 9 6 9 Z M 8 11 L 8 14 M 6.5 12.5 L 9.5 12.5" },
        { id: "gpu-tuning",  label: "GPU & DirectX",     badge-count: 0, icon-path: "M 3 6 L 21 6 L 21 16 L 3 16 Z M 7 20 L 17 20 M 12 16 L 12 20" },
        { id: "network",     label: "Network & Ping",    badge-count: 0, icon-path: "M 4 18 L 4 14 M 9 18 L 9 11 M 14 18 L 14 8 M 19 18 L 19 5" },
    ];

    private property <[NavItemData]> system-tools-items: [
        { id: "cleaner",     label: "Junk Cleaner",      badge-count: 0, icon-path: "M 4 7 L 20 7 M 9 7 L 9 4 L 15 4 L 15 7 M 6 7 L 7 20 L 17 20 L 18 7" },
        { id: "debloater",   label: "AppX Debloater",    badge-count: 0, icon-path: "M 12 3 L 20 7.5 L 20 16.5 L 12 21 L 4 16.5 L 4 7.5 Z M 12 12 L 20 7.5 M 12 12 L 4 7.5 M 12 12 L 12 21" },
        { id: "restore",     label: "Snapshots & Undo",  badge-count: 0, icon-path: "M 4 12 A 8 8 0 1 0 6.5 6.2 M 4 4 L 4 9 L 9 9" },
    ];

    private property <[NavItemData]> preferences-items: [
        { id: "profiles",    label: "Profiles",          badge-count: 0, icon-path: "M 12 11 A 4 4 0 1 0 12 3 A 4 4 0 1 0 12 11 Z M 4 20 C 4 16.5 7.5 14 12 14 C 16.5 14 20 16.5 20 20" },
        { id: "settings",    label: "Settings",          badge-count: 0, icon-path: "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 Z M 12 2 L 12 5 M 12 19 L 12 22 M 2 12 L 5 12 M 19 12 L 22 12" },
    ];

    width: root.collapsed
        ? root.collapsed-width
        : clamp(root.expanded-width, root.min-drawer-width, root.max-drawer-width);
    background: Theme.bg-glass;
    backdrop-blur: Theme.blur-radius;
    clip: true;

    // Smooth collapse/expand animation only when not actively dragging splitter
    animate width {
        duration: splitter.pressed ? 0ms : 180ms;
        easing: spring(0.2);
    }

    VerticalLayout {
        padding-top: Scale.space-sm;
        padding-bottom: Scale.space-sm;
        spacing: Scale.space-xs;

        // Drawer collapse toggle header
        HorizontalLayout {
            padding-left: Scale.space-sm;
            padding-right: Scale.space-sm;
            alignment: root.collapsed ? center : space-between;

            if !root.collapsed : Text {
                text: "NAVIGATION";
                color: Theme.text-muted;
                font-size: Scale.font-2xs;
                font-weight: 700;
                letter-spacing: 1px;
                vertical-alignment: center;
            }

            Rectangle {
                width: Scale.px(26px);
                height: Scale.px(26px);
                border-radius: Scale.radius-xs;
                background: collapse-ta.pressed ? Theme.bg-surface-active :
                            collapse-ta.has-hover ? Theme.bg-surface-hover :
                                                    transparent;

                accessible-role: button;
                accessible-label: root.collapsed ? "Expand sidebar" : "Collapse sidebar";

                Path {
                    width: Scale.px(12px);
                    height: Scale.px(12px);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: root.collapsed ? "M 6 3 L 11 8 L 6 13" : "M 10 3 L 5 8 L 10 13";
                    stroke: Theme.text-secondary;
                    stroke-width: 1.8px;
                    fill: transparent;
                }

                collapse-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.collapsed = !root.collapsed;
                    }
                }
            }
        }

        // Scrollable navigation body
        Flickable {
            vertical-stretch: 1;
            content-height: nav-content.preferred-height;

            nav-content := VerticalLayout {
                width: parent.width;
                padding-left: Scale.space-xs;
                padding-right: Scale.space-sm;
                spacing: Scale.space-2xs;

                SidebarSectionHeader { title: "OPTIMIZATION"; collapsed: root.collapsed; }
                for item in root.optimization-items : SidebarNavItem {
                    label: item.label;
                    icon-path: item.icon-path;
                    badge-count: item.badge-count;
                    active: root.active-view == item.id;
                    collapsed: root.collapsed;
                    clicked => {
                        root.active-view = item.id;
                        root.navigate(item.id);
                    }
                }

                SidebarSectionHeader { title: "DIAGNOSTICS"; collapsed: root.collapsed; }
                for item in root.diagnostics-items : SidebarNavItem {
                    label: item.label;
                    icon-path: item.icon-path;
                    badge-count: item.badge-count;
                    active: root.active-view == item.id;
                    collapsed: root.collapsed;
                    clicked => {
                        root.active-view = item.id;
                        root.navigate(item.id);
                    }
                }

                SidebarSectionHeader { title: "GAMING"; collapsed: root.collapsed; }
                for item in root.gaming-items : SidebarNavItem {
                    label: item.label;
                    icon-path: item.icon-path;
                    badge-count: item.badge-count;
                    active: root.active-view == item.id;
                    collapsed: root.collapsed;
                    clicked => {
                        root.active-view = item.id;
                        root.navigate(item.id);
                    }
                }

                SidebarSectionHeader { title: "SYSTEM & TOOLS"; collapsed: root.collapsed; }
                for item in root.system-tools-items : SidebarNavItem {
                    label: item.label;
                    icon-path: item.icon-path;
                    badge-count: item.badge-count;
                    active: root.active-view == item.id;
                    collapsed: root.collapsed;
                    clicked => {
                        root.active-view = item.id;
                        root.navigate(item.id);
                    }
                }

                SidebarSectionHeader { title: "PREFERENCES"; collapsed: root.collapsed; }
                for item in root.preferences-items : SidebarNavItem {
                    label: item.label;
                    icon-path: item.icon-path;
                    badge-count: item.badge-count;
                    active: root.active-view == item.id;
                    collapsed: root.collapsed;
                    clicked => {
                        root.active-view = item.id;
                        root.navigate(item.id);
                    }
                }
            }
        }
    }

    // Right border divider + interactive drag splitter
    Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: 100%;
        background: splitter.pressed || splitter.has-hover ? Theme.accent : Theme.border-subtle;

        animate background {
            duration: 140ms;
            easing: spring(0.1);
        }
    }

    splitter := TouchArea {
        x: parent.width - Scale.px(6px);
        y: 0px;
        width: Scale.px(6px);
        height: 100%;
        enabled: !root.collapsed;
        mouse-cursor: root.collapsed ? default : ew-resize;

        moved => {
            if (!root.collapsed && self.pressed) {
                root.expanded-width = clamp(
                    root.expanded-width + (self.mouse-x - self.pressed-x),
                    root.min-drawer-width,
                    root.max-drawer-width
                );
            }
        }

        double-clicked => {
            if (!root.collapsed) {
                root.expanded-width = root.default-drawer-width;
            }
        }
    }
}

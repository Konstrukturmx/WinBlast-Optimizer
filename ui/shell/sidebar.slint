// ui/shell/sidebar.slint
// Navigation sidebar (port of v1.6.1 build_sidebar): accent/diacritic-insensitive search, four
// localized groups, active indicator bar, fault badge / hardware status dots, compact-tier
// mode + theme controls, Prev/Next view cycling, Scan System button and staged-tweak counter.
import { ScrollView } from "std-widgets.slint";
import { Scale, Theme, Tr } from "../theme.slint";
import { AppStore } from "../stores/app.slint";
import { WbChip, WbSegmented } from "../components/chip.slint";
import { WbSearchInput } from "../components/search_input.slint";
import { WbButton } from "../components/button.slint";

struct NavDef { icon: string, key: string, view: string, dot: bool }
struct NavGroup { title-key: string, items: [NavDef] }

component NavButton inherits Rectangle {
    in property <NavDef> def;
    in property <int> badge: 0;
    // y of the enclosing group inside the scrolled list (for the gliding active pill).
    in property <length> group-y;
    // When true the sidebar draws the active highlight as a shared gliding pill.
    in property <bool> pill-mode;
    property <bool> active: AppStore.active-view == def.view;
    property <length> slot-y: self.y + root.group-y;
    property <bool> pending: false;
    // Reports the active slot to the sidebar (content coordinates).
    callback report(length /* y */, length /* height */);

    init => { root.pending = root.active; }
    changed active => { if root.active { root.pending = true; } }
    changed slot-y => { if root.active { root.report(root.slot-y, root.height); } }
    // Layout settles after creation, so report one frame later.
    Timer {
        interval: 16ms;
        running: root.pending;
        triggered => { root.pending = false; if root.active { root.report(root.slot-y, root.height); } }
    }

    height: Scale.px(32px);
    border-radius: Scale.px(Theme.btn-radius);
    background: touch.pressed ? Theme.accent.with-alpha(0.38)
        : active ? (root.pill-mode ? transparent : Theme.accent.with-alpha(0.20))
        : touch.has-hover ? Theme.bg-card-hover : transparent;
    animate background { duration: Theme.anim; }
    accessible-role: button;
    accessible-label: Tr.s(def.key);
    accessible-checked: active;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { AppStore.navigate(def.view); }
    }

    HorizontalLayout {
        padding-left: Scale.px(8px);
        padding-right: Scale.px(8px);
        spacing: Scale.px(6px);
        Rectangle {
            width: active ? Scale.px(3.5px) : 0px;
            height: Scale.px(18px);
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: root.pill-mode ? transparent : Theme.accent;
            animate width { duration: Theme.anim; }
        }
        Text {
            text: def.icon;
            font-size: Scale.font-sm;
            vertical-alignment: center;
            width: Scale.px(20px);
        }
        Text {
            text: Tr.s(def.key);
            font-size: Scale.font-sm;
            font-weight: active ? 700 : 500;
            color: active ? Theme.accent : Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0;
        }
        if badge > 0 : Rectangle {
            width: Scale.px(18px);
            height: Scale.px(18px);
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            background: Theme.danger;
            Text {
                text: badge;
                font-size: Scale.font-2xs;
                font-weight: 700;
                color: Theme.text-on-danger;
            }
        }
        if badge == 0 && def.dot : Rectangle {
            width: Scale.px(6px);
            height: Scale.px(6px);
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.warning;
        }
    }
}

export component AppSidebar inherits Rectangle {
    in property <int> tier;

    property <[NavGroup]> groups: [
        { title-key: "NavGroupOverview", items: [
            { icon: "⚡", key: "NavSystemPanel", view: "dashboard", dot: false },
            { icon: "🖥️", key: "NavHardware", view: "hardware", dot: false },
            { icon: "💾", key: "NavDriverBios", view: "driver_bios", dot: true },
        ] },
        { title-key: "NavGroupDiagnostics", items: [
            { icon: "📈", key: "NavPerfTests", view: "performance_tests", dot: false },
            { icon: "🛡️", key: "NavFaultDiag", view: "fault_diagnostics", dot: false },
            { icon: "⏱️", key: "NavLatency", view: "latency", dot: true },
            { icon: "🔲", key: "NavCoreParking", view: "cpu_parking", dot: true },
            { icon: "❄️", key: "NavThermal", view: "thermal", dot: true },
            { icon: "💽", key: "NavDisks", view: "disk_health", dot: true },
            { icon: "🎮", key: "NavGamingStats", view: "gaming_stats", dot: false },
            { icon: "📊", key: "NavFpsBench", view: "fps_benchmark", dot: false },
            { icon: "📶", key: "NavNetwork", view: "network_diag", dot: false },
        ] },
        { title-key: "NavGroupOptimization", items: [
            { icon: "⚡", key: "NavFpsOptimization", view: "matrix", dot: false },
            { icon: "🤖", key: "NavAutomationCenter", view: "automation", dot: false },
            { icon: "🎮", key: "NavGamePrereqs", view: "game_prereqs", dot: false },
            { icon: "🎯", key: "NavGoalPlanner", view: "goal_planner", dot: false },
            { icon: "🕹️", key: "NavGameProfiles", view: "game_profiles", dot: false },
            { icon: "🖥️", key: "NavGameOverlay", view: "game_overlay", dot: false },
            { icon: "🎯", key: "NavGameSuitability", view: "game_suitability", dot: false },
            { icon: "🗑️", key: "NavCleanApps", view: "clean_apps", dot: false },
            { icon: "⚙️", key: "NavStartupTasks", view: "startup_tasks", dot: false },
            { icon: "🔧", key: "NavWindowsRepair", view: "windows_repair", dot: false },
            { icon: "📄", key: "NavBackupReport", view: "backup", dot: false },
            { icon: "🎛️", key: "NavGpuMsiHags", view: "gpu", dot: false },
            { icon: "🛡️", key: "NavPrivacyShield", view: "privacy", dot: false },
        ] },
        { title-key: "NavGroupAccount", items: [
            { icon: "✉️", key: "NavSupportAbout", view: "support_about", dot: false },
        ] },
    ];

    // Gliding active-item pill (content coordinates of the nav list).
    property <length> pill-y: 0;
    property <length> pill-h: 0;
    property <bool> pill-ready: false;
    property <bool> pill-mode: AppStore.nav-search == "";

    width: Scale.px(Theme.sidebar-width);
    background: Theme.bg-sidebar;

    Rectangle {
        x: parent.width - Theme.border-width;
        width: Theme.border-width;
        background: Theme.border;
    }

    VerticalLayout {
        padding: Scale.px(10px);
        spacing: Scale.px(6px);

        WbSearchInput {
            placeholder: Tr.s("SidebarSearchPlaceholder");
            text <=> AppStore.nav-search;
        }

        ScrollView {
            vertical-stretch: 1;
            min-height: Scale.px(80px);
            Rectangle {
            if root.pill-mode && root.pill-h > 0 : Rectangle {
                y: root.pill-y;
                height: root.pill-h;
                border-radius: Scale.px(Theme.btn-radius);
                background: @linear-gradient(90deg, Theme.accent.with-alpha(0.28) 0%, Theme.accent.with-alpha(0.12) 100%);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.25);
                drop-shadow-blur: 10px;
                drop-shadow-color: Theme.accent.with-alpha(0.18);
                animate y, height { duration: root.pill-ready ? Theme.anim-enter : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }
                Rectangle {
                    x: Scale.px(8px);
                    width: Scale.px(3.5px);
                    height: Scale.px(18px);
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }
            VerticalLayout {
                spacing: Scale.px(2px);
                alignment: start;
                for group in root.groups : grp := VerticalLayout {
                    spacing: Scale.px(2px);
                    Text {
                        text: Tr.s(group.title-key);
                        font-size: Scale.font-2xs;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        color: Theme.text-muted;
                        height: Scale.px(24px);
                        vertical-alignment: bottom;
                    }
                    for item in group.items : NavButton {
                        def: item;
                        group-y: grp.y;
                        pill-mode: root.pill-mode;
                        report(y, h) => {
                            root.pill-y = y;
                            root.pill-h = h;
                            root.pill-ready = true;
                        }
                        badge: item.view == "fault_diagnostics" ? AppStore.fault-count : 0;
                        visible: AppStore.nav-search == "" || AppStore.nav-matches(Tr.s(item.key) + " " + item.icon, AppStore.nav-search);
                        height: self.visible ? Scale.px(32px) : 0px;
                    }
                }
            }
            }
        }

        if root.tier == 0 : VerticalLayout {
            spacing: Scale.px(4px);
            WbSegmented {
                left-text: Tr.s("EasyMode");
                right-text: Tr.s("AdvancedMatrix");
                left-active: AppStore.mode-easy;
                left-clicked => { AppStore.set-mode-easy(true); }
                right-clicked => { AppStore.set-mode-easy(false); }
            }
            HorizontalLayout {
                spacing: Scale.px(4px);
                WbSegmented {
                    horizontal-stretch: 1;
                    left-text: Tr.s("HeaderInstant");
                    right-text: Tr.s("HeaderNormal");
                    left-active: AppStore.engine-instant;
                    left-clicked => { AppStore.set-engine-instant(true); }
                    right-clicked => { AppStore.set-engine-instant(false); }
                }
            }
            HorizontalLayout {
                spacing: Scale.px(4px);
                WbChip { text: AppStore.color-scheme-label; tone: "accent"; clicked => { AppStore.cycle-color-scheme(); } }
                WbChip { text: AppStore.theme-style-label; tone: "accent"; clicked => { AppStore.cycle-theme-style(); } }
            }
        }

        HorizontalLayout {
            spacing: Scale.px(4px);
            WbChip { horizontal-stretch: 1; text: Tr.s("NavPrevBtn"); clicked => { AppStore.nav-prev(); } }
            WbChip { horizontal-stretch: 1; text: Tr.s("NavNextBtn"); clicked => { AppStore.nav-next(); } }
        }
        WbButton {
            variant: "primary";
            text: AppStore.is-scanning ? Tr.s("Scanning") : Tr.s("ScanSystem");
            enabled: !AppStore.is-scanning;
            loading: AppStore.is-scanning;
            clicked => { AppStore.start-scan(); }
        }
        Text {
            text: Tr.s("NavStagedCount") + ": " + AppStore.staged-count + " / " + AppStore.total-tweaks;
            font-size: Scale.font-2xs;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
    }
}
